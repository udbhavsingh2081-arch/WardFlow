# ==============================================================================
# WardFlow — Environment Configuration Template (.env.example)
# Duplicate this file as '.env' for local development or configure these
# environment variables in your hosting provider's dashboard (e.g. PieHost/PieApp).
# DO NOT COMMIT REAL PASSWORDS, CREDENTIALS, OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
# Set to 'production' on live servers, 'development' locally
NODE_ENV=production

# Server listening port (PieHost/PaaS sets this dynamically; default: 3000)
PORT=3000

# Server listening host (0.0.0.0 binds to all network interfaces for container/PaaS routing)
HOST=0.0.0.0

# Set to 1 (or true) when running behind a reverse proxy (PieHost, Nginx, Cloudflare)
# Required for secure cookies and accurate rate-limiting over HTTPS
TRUST_PROXY=1

# Application branding and public facing base URL (used for QR redirects & email links)
APP_NAME=WardFlow
APP_URL=https://your-domain.piehost.com
APP_BASE_URL=https://your-domain.piehost.com
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas or Remote MongoDB)
# ------------------------------------------------------------------------------
# Production connection string (e.g. MongoDB Atlas cluster)
# Format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
# Make sure your MongoDB Atlas Network Access whitelist allows connections (0.0.0.0/0 for cloud hosts).
MONGODB_URI=mongodb+srv://dbuser:dbpassword@cluster0.example.mongodb.net/wardflow?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Session Configuration (MongoDB-backed via connect-mongo)
# ------------------------------------------------------------------------------
# Long, cryptographically random secret string (minimum 32 characters)
SESSION_SECRET=your_production_session_secret_change_me_to_random_string_64_chars

# Session cookie lifetime in milliseconds (86400000 = 24 hours)
SESSION_MAX_AGE=86400000

# ------------------------------------------------------------------------------
# Background Workers & Escalation
# ------------------------------------------------------------------------------
# Set to 'true' to run SLA escalation checks in-process every 15 minutes.
# Set to 'false' if running a dedicated background worker dyno: `node jobs/escalationWorker.js`
RUN_ESCALATION_WORKER=true

# ------------------------------------------------------------------------------
# AI Ticket Categorization & Summarization (Optional)
# Supports either Google Gemini or OpenAI. Leave blank if not using AI.
# ------------------------------------------------------------------------------
# Option A: Google Gemini API (Recommended, uses Google's OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# Email Relay (Optional Nodemailer SMTP configuration for email alerts)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
