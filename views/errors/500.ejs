<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>500 — Server Error — WardFlow</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
<div class="text-center p-4" style="max-width: 440px;">
  <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
    <i class="bi bi-exclamation-triangle fs-2"></i>
  </div>
  <h5 class="fw-bold text-dark mb-1">Operational System Error</h5>
  <p class="text-muted small mb-4"><%= typeof message !== 'undefined' ? message : 'An unexpected server error occurred while processing this request.' %></p>
  <a href="/dashboard" class="btn btn-primary btn-sm">Return to Dashboard</a>
</div>
</body>
</html>
