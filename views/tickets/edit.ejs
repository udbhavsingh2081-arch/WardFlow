<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Ticket — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/tickets/<%= ticket._id %>" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i>Back to <%= ticket.ticketNumber %>
        </a>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="wf-card">
            <div class="wf-card-header">
              <span class="fw-semibold small">Edit Ticket: <span class="ticket-code"><%= ticket.ticketNumber %></span></span>
            </div>
            <div class="wf-card-body">
              <form method="POST" action="/tickets/<%= ticket._id %>/edit">
                <div class="mb-3">
                  <label class="form-label">Issue Title <span class="text-danger">*</span></label>
                  <input type="text" class="form-control form-control-sm" name="title" value="<%= ticket.title %>" required maxlength="200" />
                </div>
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <select class="form-select form-select-sm text-capitalize" name="category">
                      <% CATEGORIES.forEach(c => { %>
                      <option value="<%= c %>" <%= ticket.category === c ? 'selected' : '' %>><%= c %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Priority</label>
                    <select class="form-select form-select-sm text-capitalize" name="priority">
                      <% PRIORITIES.forEach(p => { %>
                      <option value="<%= p %>" <%= ticket.priority === p ? 'selected' : '' %>><%= p %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label">Reporting Department</label>
                  <select class="form-select form-select-sm" name="departmentId">
                    <% departments.forEach(d => { %>
                    <option value="<%= d._id %>" <%= (ticket.reportingDepartmentId && ticket.reportingDepartmentId.toString() === d._id.toString()) ? 'selected' : '' %>><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-4">
                  <label class="form-label">Description</label>
                  <textarea class="form-control form-control-sm" name="description" rows="5" required maxlength="2000"><%= ticket.description %></textarea>
                </div>
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                  <a href="/tickets/<%= ticket._id %>" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
