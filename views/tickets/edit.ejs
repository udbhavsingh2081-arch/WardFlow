<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Edit Ticket — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>
    <div class="card border-0 shadow-sm" style="max-width:680px">
      <div class="card-header fw-semibold bg-white">Edit Ticket: <%= ticket.ticketNumber %></div>
      <div class="card-body">
        <form method="POST" action="/tickets/<%= ticket._id %>">
          <div class="mb-3">
            <label class="form-label fw-semibold">Title</label>
            <input type="text" class="form-control" name="title" value="<%= ticket.title %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Description</label>
            <textarea class="form-control" name="description" rows="4" required><%= ticket.description %></textarea>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Category</label>
              <select class="form-select text-capitalize" name="category">
                <% CATEGORIES.forEach(c => { %><option value="<%= c %>" <%= ticket.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Priority</label>
              <select class="form-select text-capitalize" name="priority">
                <% PRIORITIES.forEach(p => { %><option value="<%= p %>" <%= ticket.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
              </select>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/tickets/<%= ticket._id %>" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
