<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tickets — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <h5 class="fw-bold mb-0">Operational Issue Register</h5>
          <span class="badge bg-light text-secondary border fw-semibold"><%= pagination.total %> tickets</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <% if (currentUser && ['supervisor','operations_manager','hospital_admin'].includes(currentUser.role)) { %>
          <a href="/api/reports/export" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-cloud-arrow-down me-1"></i>Export CSV
          </a>
          <% } %>
          <a href="/tickets/new" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Report Issue
          </a>
        </div>
      </div>

      <div class="wf-card mb-3">
        <div class="p-3">
          <form method="GET" action="/tickets" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
              <label class="form-label mb-1">Search Tickets</label>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control form-control-sm border-start-0 ps-0" name="search" placeholder="Ticket # or title..." value="<%= filters.search || '' %>" />
              </div>
            </div>

            <div class="col-6 col-sm-4 col-md-2">
              <label class="form-label mb-1">Status</label>
              <select class="form-select form-select-sm text-capitalize" name="status">
                <option value="">All Statuses</option>
                <% STATUSES.forEach(s => { %>
                  <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-sm-4 col-md-2">
              <label class="form-label mb-1">Priority</label>
              <select class="form-select form-select-sm text-capitalize" name="priority">
                <option value="">All Priorities</option>
                <% PRIORITIES.forEach(p => { %>
                  <option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-sm-4 col-md-2">
              <label class="form-label mb-1">Category</label>
              <select class="form-select form-select-sm text-capitalize" name="category">
                <option value="">All Categories</option>
                <% CATEGORIES.forEach(c => { %>
                  <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-sm-4 col-md-2">
              <label class="form-label mb-1">Department</label>
              <select class="form-select form-select-sm" name="departmentId">
                <option value="">All Departments</option>
                <% departments.forEach(d => { %>
                  <option value="<%= d._id %>" <%= filters.departmentId === d._id.toString() ? 'selected' : '' %>><%= d.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12 col-md-1 d-flex gap-1">
              <button type="submit" class="btn btn-sm btn-primary flex-grow-1" title="Apply Filters">
                Filter
              </button>
              <% if (filters.search || filters.status || filters.priority || filters.category || filters.departmentId) { %>
              <a href="/tickets" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                <i class="bi bi-x-lg"></i>
              </a>
              <% } %>
            </div>
          </form>
        </div>
      </div>

      <div class="wf-table-container">
        <div class="table-responsive">
          <table class="wf-table">
            <thead>
              <tr>
                <th style="width: 130px;">Ticket #</th>
                <th>Summary &amp; Location</th>
                <th style="width: 120px;">Category</th>
                <th style="width: 110px;">Priority</th>
                <th style="width: 130px;">Status</th>
                <th>Assigned To</th>
                <th class="text-end" style="width: 130px;">SLA Deadline</th>
              </tr>
            </thead>
            <tbody>
              <% if (!tickets || tickets.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-inbox fs-2 text-secondary d-block mb-2"></i>
                  <div class="fw-semibold text-dark">No operational issues found</div>
                  <div class="small text-muted mb-3">Try adjusting your search criteria or report a new operational problem.</div>
                  <a href="/tickets/new" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Report Issue
                  </a>
                </td>
              </tr>
              <% } %>

              <% tickets.forEach(t => { %>
              <tr class="ticket-row" data-href="/tickets/<%= t._id %>">
                <td class="ticket-code">
                  <a href="/tickets/<%= t._id %>" class="text-decoration-none"><%= t.ticketNumber %></a>
                </td>

                <td>
                  <div class="fw-semibold text-dark text-truncate" style="max-width: 380px;"><%= t.title %></div>
                  <div class="text-muted" style="font-size: 0.6875rem;">
                    <i class="bi bi-building me-1"></i><%= t.reportingDepartmentId ? t.reportingDepartmentId.name : 'Unassigned Dept' %>
                  </div>
                </td>

                <td>
                  <span class="badge bg-light text-secondary border small text-capitalize fw-normal">
                    <%= t.category %>
                  </span>
                </td>

                <td>
                  <span class="wf-badge badge-priority-<%= t.priority %> text-uppercase">
                    <span class="status-dot"></span>
                    <%= t.priority %>
                  </span>
                </td>

                <td>
                  <span class="wf-badge badge-status-<%= t.status %>">
                    <span class="status-dot"></span>
                    <%= t.status.replace(/_/g, ' ') %>
                  </span>
                </td>

                <td class="small">
                  <% if (t.assignedTo) { %>
                    <span class="text-dark fw-medium"><%= t.assignedTo.name %></span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace" style="font-size: 0.6875rem;">
                      Unassigned
                    </span>
                  <% } %>
                </td>

                <td class="text-end small">
                  <% const isOverdue = t.dueAt && new Date(t.dueAt) < new Date() && !['closed','resolved','cancelled'].includes(t.status); %>
                  <% if (isOverdue) { %>
                    <span class="badge badge-overdue border" title="<%= new Date(t.dueAt).toLocaleString('en-IN') %>">
                      <i class="bi bi-alarm me-1"></i>Overdue
                    </span>
                  <% } else if (t.dueAt) { %>
                    <span class="text-muted" title="<%= new Date(t.dueAt).toLocaleString('en-IN') %>">
                      <%= new Date(t.dueAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="wf-card-footer d-flex justify-content-between align-items-center">
          <small class="text-muted">
            Page <strong><%= pagination.page %></strong> of <strong><%= pagination.totalPages %></strong> (<%= pagination.total %> total tickets)
          </small>
          <nav>
            <ul class="pagination pagination-sm mb-0">
              <% if (pagination.page > 1) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= pagination.page - 1 %>&search=<%= filters.search || '' %>&status=<%= filters.status || '' %>&priority=<%= filters.priority || '' %>&category=<%= filters.category || '' %>&departmentId=<%= filters.departmentId || '' %>">
                  Previous
                </a>
              </li>
              <% } %>
              <% if (pagination.page < pagination.totalPages) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= pagination.page + 1 %>&search=<%= filters.search || '' %>&status=<%= filters.status || '' %>&priority=<%= filters.priority || '' %>&category=<%= filters.category || '' %>&departmentId=<%= filters.departmentId || '' %>">
                  Next
                </a>
              </li>
              <% } %>
            </ul>
          </nav>
        </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
