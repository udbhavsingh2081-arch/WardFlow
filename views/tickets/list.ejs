<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tickets — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body py-2">
        <form method="GET" action="/tickets" class="row g-2 align-items-end">
          <div class="col-md-3">
            <input type="text" class="form-control form-control-sm" name="search" placeholder="Search title or ticket #..." value="<%= filters.search || '' %>" />
          </div>
          <div class="col-md-2">
            <select class="form-select form-select-sm" name="status">
              <option value="">All Statuses</option>
              <% STATUSES.forEach(s => { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select form-select-sm" name="priority">
              <option value="">All Priorities</option>
              <% PRIORITIES.forEach(p => { %><option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select form-select-sm" name="category">
              <option value="">All Categories</option>
              <% CATEGORIES.forEach(c => { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select form-select-sm" name="departmentId">
              <option value="">All Departments</option>
              <% departments.forEach(d => { %><option value="<%= d._id %>" <%= filters.departmentId === d._id.toString() ? 'selected' : '' %>><%= d.name %></option><% }) %>
            </select>
          </div>
          <div class="col-md-1">
            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-search"></i></button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tickets Table -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Operational Issue Register <span class="badge bg-secondary ms-1"><%= pagination.total %></span></span>
        <div class="d-flex gap-2">
          <% if (currentUser && ['supervisor','operations_manager','hospital_admin'].includes(currentUser.role)) { %>
          <a href="/api/reports/export" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download me-1"></i>CSV</a>
          <% } %>
          <a href="/tickets/new" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle me-1"></i>Report Issue</a>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Ticket #</th>
              <th>Title</th>
              <th>Category</th>
              <th>Priority</th>
              <th>Status</th>
              <th>Department</th>
              <th>Assigned To</th>
              <th>Due</th>
            </tr>
          </thead>
          <tbody>
            <% if (tickets.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No tickets found matching the criteria.</td></tr>
            <% } %>
            <% tickets.forEach(t => { %>
            <tr class="ticket-row" data-href="/tickets/<%= t._id %>">
              <td class="ps-3"><a href="/tickets/<%= t._id %>" class="fw-semibold text-decoration-none small"><%= t.ticketNumber %></a></td>
              <td><span class="small fw-semibold"><%= t.title.substring(0, 50) %><%= t.title.length > 50 ? '…' : '' %></span></td>
              <td><span class="badge bg-light text-dark border small text-capitalize"><%= t.category %></span></td>
              <td><span class="badge badge-priority-<%= t.priority %>"><%= t.priority %></span></td>
              <td><span class="badge badge-status-<%= t.status %>"><%= t.status.replace('_',' ') %></span></td>
              <td class="small text-muted"><%= t.reportingDepartmentId ? t.reportingDepartmentId.name : '—' %></td>
              <td class="small text-muted"><%- t.assignedTo ? t.assignedTo.name : '<span class="text-warning">Unassigned</span>' %></td>
              <td class="small <%= t.dueAt && new Date(t.dueAt) < new Date() && !['closed','resolved','cancelled'].includes(t.status) ? 'text-danger fw-semibold' : 'text-muted' %>">
                <% if (t.dueAt) { %><%= new Date(t.dueAt).toLocaleDateString('en-IN') %><% } else { %>—<% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (pagination.totalPages > 1) { %>
      <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <small class="text-muted">Showing page <%= pagination.page %> of <%= pagination.totalPages %></small>
        <nav>
          <ul class="pagination pagination-sm mb-0">
            <% if (pagination.page > 1) { %><li class="page-item"><a class="page-link" href="?page=<%= pagination.page - 1 %>">Prev</a></li><% } %>
            <% if (pagination.page < pagination.totalPages) { %><li class="page-item"><a class="page-link" href="?page=<%= pagination.page + 1 %>">Next</a></li><% } %>
          </ul>
        </nav>
      </div>
      <% } %>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
