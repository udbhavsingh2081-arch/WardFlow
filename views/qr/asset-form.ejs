<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="d-flex align-items-center mb-3">
            <a href="/qr/assets" class="btn btn-outline-secondary btn-sm me-3">
              <i class="bi bi-arrow-left me-1"></i>Back to Register
            </a>
            <h5 class="mb-0 fw-bold"><%= isEdit ? 'Edit QR Asset' : 'Register Asset or Facility Location' %></h5>
          </div>

          <div class="wf-card">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-tag me-1 text-primary"></i>Asset Identification</span>
              <span class="meta-label text-danger">* Required</span>
            </div>
            <div class="wf-card-body">
              <form action="<%= formAction %>" method="<%= formMethod %>">
                <div class="row g-3">
                  <div class="col-md-8">
                    <label for="name" class="form-label">Asset or Location Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" id="name" name="name" required maxlength="100"
                      placeholder="e.g. ICU Ventilator #04, Male Ward Water Cooler, Diesel Generator DG-1"
                      value="<%= asset.name || '' %>">
                    <div class="form-text" style="font-size: 0.7rem;">Clear, recognizable name displayed to reporting staff.</div>
                  </div>

                  <div class="col-md-4">
                    <label for="assetCode" class="form-label">Asset Tag / Reference Code</label>
                    <input type="text" class="form-control form-control-sm font-monospace" id="assetCode" name="assetCode" maxlength="30"
                      placeholder="e.g. BME-ICU-04"
                      value="<%= asset.assetCode || '' %>">
                    <div class="form-text" style="font-size: 0.7rem;">Internal asset tag or serial reference.</div>
                  </div>

                  <div class="col-md-6">
                    <label for="assetType" class="form-label">Asset Type</label>
                    <select class="form-select form-select-sm" id="assetType" name="assetType">
                      <option value="equipment" <%= asset.assetType === 'equipment' ? 'selected' : '' %>>Equipment / Biomedical Device</option>
                      <option value="room" <%= asset.assetType === 'room' ? 'selected' : '' %>>Room / Ward / Clinical Unit</option>
                      <option value="facility" <%= asset.assetType === 'facility' ? 'selected' : '' %>>Facility / Utility Infrastructure</option>
                      <option value="other" <%= (!asset.assetType || asset.assetType === 'other') ? 'selected' : '' %>>Other Physical Asset</option>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label for="departmentId" class="form-label">Responsible Department</label>
                    <select class="form-select form-select-sm" id="departmentId" name="departmentId">
                      <option value="">— Hospital-Wide / Unassigned —</option>
                      <% departments.forEach(dept => { %>
                        <option value="<%= dept._id %>" <%= (asset.departmentId && (asset.departmentId._id ? asset.departmentId._id.toString() : asset.departmentId.toString()) === dept._id.toString()) ? 'selected' : '' %>>
                          <%= dept.name %>
                        </option>
                      <% }) %>
                    </select>
                    <div class="form-text" style="font-size: 0.7rem;">Issues reported from this QR code will route here.</div>
                  </div>

                  <div class="col-12">
                    <label for="location" class="form-label">Physical Location Details</label>
                    <input type="text" class="form-control form-control-sm" id="location" name="location" maxlength="200"
                      placeholder="e.g. Building B, 2nd Floor, Bed 204 near Nurse Station"
                      value="<%= asset.location || '' %>">
                    <div class="form-text" style="font-size: 0.7rem;">Helps technician immediately locate the machine.</div>
                  </div>

                  <div class="col-12">
                    <label for="description" class="form-label">Operational Notes / Handling Instructions</label>
                    <textarea class="form-control form-control-sm" id="description" name="description" rows="3" maxlength="500"
                      placeholder="Optional model number, manufacturer, or maintenance instructions..."><%= asset.description || '' %></textarea>
                  </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                  <a href="/qr/assets" class="btn btn-sm btn-outline-secondary">Cancel</a>
                  <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi <%= isEdit ? 'bi-check2' : 'bi-qr-code' %> me-1"></i>
                    <%= isEdit ? 'Save Changes' : 'Generate QR Code' %>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
