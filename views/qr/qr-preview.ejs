<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QR Code — <%= asset.name %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
  <style>
    @media print {
      body * {
        visibility: hidden !important;
      }
      #printable-qr-label, #printable-qr-label * {
        visibility: visible !important;
      }
      #printable-qr-label {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        max-width: 420px !important;
        margin: 0 auto !important;
        border: 2px solid #000 !important;
        box-shadow: none !important;
        padding: 1.5rem !important;
      }
      .no-print {
        display: none !important;
      }
    }

    .qr-label-card {
      max-width: 420px;
      margin: 0 auto;
      border: 1px solid var(--wf-border-strong);
      border-radius: 12px;
      background: #ffffff;
      box-shadow: var(--wf-shadow-sm);
    }
  </style>
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2 no-print">
        <div class="d-flex align-items-center gap-2">
          <a href="/qr/assets" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Register
          </a>
          <h5 class="mb-0 fw-bold">QR Label Preview</h5>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print Adhesive Label
          </button>
          <a href="<%= qrDataUrl %>" download="QR-<%= (asset.assetCode || asset.name).replace(/\s+/g, '_') %>.png" class="btn btn-sm btn-primary">
            <i class="bi bi-download me-1"></i>Download PNG
          </a>
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-6 mb-4">
          <div id="printable-qr-label" class="qr-label-card p-4 text-center">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
              <i class="bi bi-hospital fs-5 text-primary"></i>
              <span class="fw-bold fs-6 text-dark"><%= appName %> Operations</span>
            </div>
            <div class="badge bg-light text-secondary border mb-3 text-uppercase font-monospace" style="font-size: 0.65rem;">
              Instant Issue Reporting
            </div>

            <div class="p-2 bg-white rounded-2 d-inline-block border mb-3">
              <img src="<%= qrDataUrl %>" alt="QR Code" class="img-fluid" style="width: 220px; height: 220px;" />
            </div>

            <h6 class="fw-bold text-dark mb-1"><%= asset.name %></h6>
            <% if (asset.assetCode) { %>
              <div class="font-monospace text-secondary fw-semibold small mb-2"><%= asset.assetCode %></div>
            <% } %>

            <% if (asset.departmentId) { %>
              <div class="small text-muted mb-1">
                <i class="bi bi-building me-1"></i><strong>Dept:</strong> <%= asset.departmentId.name %>
              </div>
            <% } %>

            <% if (asset.location) { %>
              <div class="small text-muted mb-2">
                <i class="bi bi-geo-alt me-1"></i><strong>Location:</strong> <%= asset.location %>
              </div>
            <% } %>

            <hr class="my-3" />
            <div class="text-secondary" style="font-size: 0.72rem; line-height: 1.4;">
              <i class="bi bi-camera me-1 text-primary"></i>
              Scan with phone camera to report a fault. Form pre-populates machine details.
            </div>
          </div>
        </div>

        <div class="col-lg-5 no-print">
          <div class="wf-card mb-3">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-link-45deg me-1 text-primary"></i>Scannable Public URL</span>
            </div>
            <div class="wf-card-body">
              <label class="form-label mb-1">Reporting Endpoint</label>
              <div class="input-group input-group-sm mb-3">
                <input type="text" id="reportUrlInput" class="form-control font-monospace" value="<%= reportUrl %>" readonly>
                <button class="btn btn-outline-secondary" type="button" onclick="copyReportUrl()">
                  <i class="bi bi-clipboard"></i> Copy
                </button>
              </div>

              <div class="small text-muted mb-3" style="font-size: 0.75rem;">
                <i class="bi bi-shield-check text-success me-1"></i>
                <strong>Opaque Token:</strong> This URL uses a revocable 256-bit crypto token. No internal database IDs or hospital secrets are exposed.
              </div>

              <div class="d-flex gap-2">
                <a href="<%= reportUrl %>" target="_blank" class="btn btn-sm btn-outline-primary flex-grow-1">
                  <i class="bi bi-box-arrow-up-right me-1"></i>Test Mobile Form
                </a>
                <a href="/qr/assets/<%= asset._id %>/edit" class="btn btn-sm btn-outline-secondary">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
              </div>
            </div>
          </div>

          <div class="wf-card border-danger border-opacity-25">
            <div class="wf-card-header">
              <span class="fw-semibold small text-danger"><i class="bi bi-arrow-repeat me-1"></i>Token Rotation &amp; Revocation</span>
            </div>
            <div class="wf-card-body">
              <p class="small text-muted mb-3" style="font-size: 0.75rem;">
                If a physical sticker is damaged or compromised, regenerating the token will immediately invalidate previous QR prints.
              </p>
              <form action="/qr/assets/<%= asset._id %>/regenerate" method="POST" onsubmit="return confirm('Regenerate QR token? All previously printed QR codes for this asset will immediately stop working.');">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                  <i class="bi bi-arrow-repeat me-1"></i>Regenerate QR Token
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
<script>
  function copyReportUrl() {
    const input = document.getElementById('reportUrlInput');
    input.select();
    navigator.clipboard.writeText(input.value).then(() => {
      alert('Report URL copied to clipboard!');
    });
  }
</script>
</body>
</html>
