<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QR Code — <%= asset.name %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
  <style>
    /* Print-specific styles for clean adhesive label / card printing */
    @media print {
      body * {
        visibility: hidden !important;
      }
      #printable-qr-label, #printable-qr-label * {
        visibility: visible !important;
      }
      #printable-qr-label {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        max-width: 480px !important;
        margin: 0 auto !important;
        border: 2px solid #000 !important;
        box-shadow: none !important;
      }
      .no-print {
        display: none !important;
      }
    }

    .qr-label-card {
      max-width: 460px;
      margin: 0 auto;
      border: 2px dashed #0d6efd;
      border-radius: 16px;
      background: #ffffff;
    }
  </style>
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2 no-print">
      <div class="d-flex align-items-center gap-3">
        <a href="/qr/assets" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left"></i> Back to Register
        </a>
        <h4 class="mb-0 fw-bold">QR Label Preview</h4>
      </div>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">
          <i class="bi bi-printer me-1"></i> Print Label
        </button>
        <a href="<%= qrDataUrl %>" download="QR-<%= (asset.assetCode || asset.name).replace(/\s+/g, '_') %>.png" class="btn btn-primary">
          <i class="bi bi-download me-1"></i> Download PNG
        </a>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-6 mb-4">
        <!-- Printable QR Label Card -->
        <div id="printable-qr-label" class="qr-label-card p-4 text-center shadow-sm">
          <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
            <i class="bi bi-hospital fs-4 text-primary"></i>
            <span class="fw-bold fs-5 text-dark"><%= appName %></span>
          </div>
          <div class="badge bg-primary-subtle text-primary mb-3 text-uppercase px-3 py-1">Operations Issue Reporting</div>

          <div class="p-2 bg-white rounded-3 d-inline-block border mb-3">
            <img src="<%= qrDataUrl %>" alt="QR Code" class="img-fluid" style="width: 240px; height: 240px;" />
          </div>

          <h5 class="fw-bold text-dark mb-1"><%= asset.name %></h5>
          <% if (asset.assetCode) { %>
            <div class="font-monospace text-secondary fw-semibold mb-2">Code: <%= asset.assetCode %></div>
          <% } %>

          <% if (asset.departmentId) { %>
            <div class="small text-muted mb-1">
              <i class="bi bi-building me-1"></i><strong>Department:</strong> <%= asset.departmentId.name %>
            </div>
          <% } %>

          <% if (asset.location) { %>
            <div class="small text-muted mb-2">
              <i class="bi bi-geo-alt me-1"></i><strong>Location:</strong> <%= asset.location %>
            </div>
          <% } %>

          <hr class="my-3" />
          <div class="small text-muted">
            <i class="bi bi-camera me-1 text-primary"></i>
            <strong>Scan with phone camera</strong> to report an issue directly with prefilled location details. No app install needed.
          </div>
        </div>
      </div>

      <div class="col-lg-5 no-print">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-header bg-white py-3 fw-semibold">
            <i class="bi bi-link-45deg me-1 text-primary"></i> Reporting URL Details
          </div>
          <div class="card-body">
            <label class="form-label small text-muted">Scannable Public URL</label>
            <div class="input-group mb-3">
              <input type="text" id="reportUrlInput" class="form-control form-control-sm font-monospace" value="<%= reportUrl %>" readonly>
              <button class="btn btn-sm btn-outline-secondary" type="button" onclick="copyReportUrl()">
                <i class="bi bi-clipboard"></i> Copy
              </button>
            </div>

            <div class="small text-muted mb-3">
              <i class="bi bi-shield-check text-success me-1"></i>
              <strong>Security Token:</strong> This URL uses a revocable, 256-bit cryptographically secure token. Internal database IDs and sensitive server data are never exposed in the URL.
            </div>

            <div class="d-flex gap-2">
              <a href="<%= reportUrl %>" target="_blank" class="btn btn-sm btn-outline-primary flex-grow-1">
                <i class="bi bi-box-arrow-up-right me-1"></i> Test Mobile Form
              </a>
              <a href="/qr/assets/<%= asset._id %>/edit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-pencil me-1"></i> Edit Asset
              </a>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-header bg-white py-3 fw-semibold text-danger">
            <i class="bi bi-shield-exclamation me-1"></i> Revocation & Token Rotation
          </div>
          <div class="card-body">
            <p class="small text-muted mb-3">
              If a physical QR sticker was compromised or replaced, you can regenerate its token.
              <strong>This will immediately invalidate any previously printed QR codes for this asset.</strong>
            </p>
            <form action="/qr/assets/<%= asset._id %>/regenerate" method="POST" onsubmit="return confirm('Regenerate QR token? All previously printed QR codes for this asset will immediately stop working.');">
              <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                <i class="bi bi-arrow-repeat me-1"></i> Regenerate QR Token
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
<script>
  function copyReportUrl() {
    const input = document.getElementById('reportUrlInput');
    input.select();
    navigator.clipboard.writeText(input.value).then(() => {
      alert('Report URL copied to clipboard!');
    });
  }
</script>
</body>
</html>
