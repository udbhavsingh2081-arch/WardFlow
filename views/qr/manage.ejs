<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QR Asset Register — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h5 class="fw-bold mb-1"><i class="bi bi-qr-code-scan text-primary me-2"></i>QR Asset & Location Register</h5>
          <p class="text-muted small mb-0">Create and print QR stickers for hospital equipment and facility rooms.</p>
        </div>
        <div>
          <a href="/qr/assets/new" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Equipment / Room
          </a>
        </div>
      </div>

      <div class="wf-table-container">
        <div class="table-responsive">
          <table class="wf-table">
            <thead>
              <tr>
                <th class="ps-4">Equipment / Room</th>
                <th>Code</th>
                <th>Type</th>
                <th>Department</th>
                <th>Location</th>
                <th>Status</th>
                <th>Added On</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!assets || assets.length === 0) { %>
                <tr>
                  <td colspan="8" class="text-center py-5 text-muted">
                    <i class="bi bi-qr-code fs-2 d-block mb-2 text-secondary"></i>
                    <div class="fw-semibold text-dark">No physical assets registered</div>
                    <div class="small text-muted mb-3">Register your first equipment or room to generate an adhesive QR reporting sticker.</div>
                    <a href="/qr/assets/new" class="btn btn-sm btn-primary">
                      <i class="bi bi-plus-lg me-1"></i>Register Asset
                    </a>
                  </td>
                </tr>
              <% } else { %>
                <% assets.forEach(a => { %>
                  <tr class="<%= !a.isActive ? 'opacity-75' : '' %>">
                    <td class="ps-4 fw-semibold text-dark">
                      <i class="bi <%= a.assetType === 'equipment' ? 'bi-cpu' : a.assetType === 'room' ? 'bi-door-closed' : 'bi-geo-alt' %> text-primary me-2"></i>
                      <%= a.name %>
                      <% if (a.description) { %>
                        <div class="text-muted fw-normal text-truncate" style="font-size: 0.72rem; max-width: 260px;"><%= a.description %></div>
                      <% } %>
                    </td>
                    <td>
                      <% if (a.assetCode) { %>
                        <span class="badge bg-light text-secondary border font-monospace"><%= a.assetCode %></span>
                      <% } else { %>
                        <span class="text-muted small">—</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border text-capitalize fw-normal"><%= a.assetType %></span>
                    </td>
                    <td class="small">
                      <% if (a.departmentId) { %>
                        <%= a.departmentId.name %>
                      <% } else { %>
                        <span class="text-muted">Hospital-wide</span>
                      <% } %>
                    </td>
                    <td class="small text-secondary">
                      <% if (a.location) { %>
                        <%= a.location %>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (a.isActive) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Active</span>
                      <% } else { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-slash-circle me-1"></i>Retired</span>
                      <% } %>
                    </td>
                    <td class="small text-muted">
                      <%= new Date(a.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td class="text-end pe-4">
                      <div class="btn-group btn-group-sm">
                        <a href="/qr/assets/<%= a._id %>/qr" class="btn btn-outline-primary" title="View & Print QR">
                          <i class="bi bi-qr-code me-1"></i>QR Label
                        </a>
                        <a href="/qr/assets/<%= a._id %>/edit" class="btn btn-outline-secondary" title="Edit Metadata">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <% if (a.isActive) { %>
                          <form action="/qr/assets/<%= a._id %>/retire" method="POST" class="d-inline" onsubmit="return confirm('Retire QR code for <%= a.name %>? Scanning it will no longer allow submitting reports.');">
                            <button type="submit" class="btn btn-outline-danger" title="Retire Asset">
                              <i class="bi bi-slash-circle"></i>
                            </button>
                          </form>
                        <% } else { %>
                          <form action="/qr/assets/<%= a._id %>/reactivate" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-outline-success" title="Reactivate Asset">
                              <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
