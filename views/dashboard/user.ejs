<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Service Portal — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <!-- Hero Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
          <h4 class="fw-bold mb-1">
            <i class="bi bi-person-check text-primary me-2"></i>Welcome, <%= currentUser.name %>
          </h4>
          <p class="text-muted small mb-0">Track your reported facility, equipment, and ward maintenance requests in real-time.</p>
        </div>
        <div>
          <a href="/tickets/new" class="btn btn-primary px-3 py-2 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Report New Issue
          </a>
        </div>
      </div>

      <!-- Quick Metrics -->
      <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-4">
              <i class="bi bi-file-earmark-text"></i>
            </div>
            <div>
              <div class="text-muted small fw-medium">Total Submitted</div>
              <div class="fs-4 fw-bold text-dark"><%= totalReported %></div>
            </div>
          </div>
        </div>
        <div class="col-sm-6 col-md-4">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3 fs-4">
              <i class="bi bi-clock-history"></i>
            </div>
            <div>
              <div class="text-muted small fw-medium">In Progress / Pending</div>
              <div class="fs-4 fw-bold text-dark"><%= activeCount %></div>
            </div>
          </div>
        </div>
        <div class="col-sm-6 col-md-4">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-4">
              <i class="bi bi-check-circle"></i>
            </div>
            <div>
              <div class="text-muted small fw-medium">Resolved & Completed</div>
              <div class="fs-4 fw-bold text-dark"><%= resolvedCount %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- My Requests List -->
      <div class="wf-card">
        <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span class="fw-semibold"><i class="bi bi-card-checklist me-2 text-primary"></i>My Submitted Requests</span>
          <span class="badge bg-light text-muted border"><%= myTickets ? myTickets.length : 0 %> recent</span>
        </div>
        <div class="card-body p-0">
          <% if (!myTickets || myTickets.length === 0) { %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-inbox fs-1 text-secondary opacity-50 d-block mb-3"></i>
              <h6 class="fw-bold text-dark mb-1">No requests submitted yet</h6>
              <p class="small text-muted mb-3">Have an issue in your ward or department? Submit a report and our staff will handle it.</p>
              <a href="/tickets/new" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Submit First Request
              </a>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                  <tr>
                    <th class="ps-4">Ticket</th>
                    <th>Issue Summary</th>
                    <th>Category</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Assigned Staff</th>
                    <th>Submitted</th>
                    <th class="text-end pe-4">Action</th>
                  </tr>
                </thead>
                <tbody class="small">
                  <% myTickets.forEach(t => { %>
                    <tr class="ticket-row" data-href="/tickets/<%= t._id %>">
                      <td class="ps-4 fw-semibold text-primary">
                        <code><%= t.ticketNumber %></code>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark text-truncate" style="max-width: 280px;"><%= t.title %></div>
                        <% if (t.status === 'resolved' && t.resolutionSummary) { %>
                          <div class="text-success small mt-1 text-truncate" style="max-width: 280px;">
                            <i class="bi bi-check2 me-1"></i><strong>Fix:</strong> <%= t.resolutionSummary %>
                          </div>
                        <% } else if (t.status === 'blocked' && t.blockedReason) { %>
                          <div class="text-warning small mt-1 text-truncate" style="max-width: 280px;">
                            <i class="bi bi-hourglass-split me-1"></i><strong>Waiting:</strong> <%= t.blockedReason %>
                          </div>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border text-capitalize"><%= t.category %></span>
                      </td>
                      <td class="text-muted"><%= t.reportingDepartmentId?.name || '—' %></td>
                      <td>
                        <span class="badge badge-status-<%= t.status %>">
                          <%= t.status.replace('_', ' ') %>
                        </span>
                      </td>
                      <td class="text-muted">
                        <%= t.assignedTo?.name || 'Awaiting assignment' %>
                      </td>
                      <td class="text-muted">
                        <%= new Date(t.createdAt).toLocaleDateString() %>
                      </td>
                      <td class="text-end pe-4">
                        <a href="/tickets/<%= t._id %>" class="btn btn-sm btn-outline-primary py-1 px-2" title="Inspect request">
                          View <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
