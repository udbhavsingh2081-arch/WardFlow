<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <!-- Dashboard Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h5 class="fw-bold mb-1">Operations Overview</h5>
          <p class="text-muted small mb-0">Live hospital work orders, urgent SLA deadlines, and team workload.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <% if (currentUser && ['supervisor','operations_manager','hospital_admin','platform_admin'].includes(currentUser.role)) { %>
          <a href="/analytics" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-bar-chart-line me-1"></i>Analytics View
          </a>
          <% } %>
          <a href="/tickets/new" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Report Issue
          </a>
        </div>
      </div>

      <!-- Primary 4 KPI Metrics -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="wf-kpi-tile">
            <div class="kpi-label">
              <span>Open Workload</span>
              <i class="bi bi-inbox text-secondary"></i>
            </div>
            <div class="kpi-number"><%= totalOpen %></div>
            <div class="kpi-footer">
              <span class="text-secondary fw-semibold">Active unresolved tickets</span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="wf-kpi-tile <%= overdueCount > 0 ? 'kpi-danger' : '' %>">
            <div class="kpi-label">
              <span class="<%= overdueCount > 0 ? 'text-danger' : '' %>">Overdue Tickets</span>
              <i class="bi bi-alarm <%= overdueCount > 0 ? 'text-danger' : 'text-secondary' %>"></i>
            </div>
            <div class="kpi-number <%= overdueCount > 0 ? 'text-danger' : '' %>"><%= overdueCount %></div>
            <div class="kpi-footer">
              <% if (overdueCount > 0) { %>
                <span class="text-danger fw-semibold"><i class="bi bi-exclamation-circle-fill me-1"></i>Exceeded SLA deadline</span>
              <% } else { %>
                <span class="text-success"><i class="bi bi-check-circle me-1"></i>All tickets on schedule</span>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="wf-kpi-tile <%= unassigned > 0 ? 'kpi-warning' : '' %>">
            <div class="kpi-label">
              <span class="<%= unassigned > 0 ? 'text-warning-emphasis' : '' %>">Awaiting Assignment</span>
              <i class="bi bi-person-x <%= unassigned > 0 ? 'text-warning' : 'text-secondary' %>"></i>
            </div>
            <div class="kpi-number <%= unassigned > 0 ? 'text-warning-emphasis' : '' %>"><%= unassigned %></div>
            <div class="kpi-footer">
              <span class="text-muted">Unclaimed by technician</span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="wf-kpi-tile <%= critical > 0 ? 'kpi-danger' : '' %>">
            <div class="kpi-label">
              <span class="<%= critical > 0 ? 'text-danger' : '' %>">Critical Priority</span>
              <i class="bi bi-lightning-charge <%= critical > 0 ? 'text-danger' : 'text-secondary' %>"></i>
            </div>
            <div class="kpi-number <%= critical > 0 ? 'text-danger' : '' %>"><%= critical %></div>
            <div class="kpi-footer">
              <span class="text-muted">High clinical impact</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Secondary Telemetry Strip: SLA Attainment & Avg Resolution Time -->
      <% if (slaAttainment !== null || avgResolutionHours !== null) { %>
      <div class="row g-3 mb-4">
        <% if (slaAttainment !== null) { %>
        <div class="col-md-6 col-lg-4">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-success-subtle text-success p-2" style="width: 44px; height: 44px;">
              <i class="bi bi-shield-check fs-5"></i>
            </div>
            <div class="flex-grow-1">
              <div class="d-flex align-items-baseline justify-content-between">
                <span class="fs-5 fw-bold text-dark"><%= slaAttainment %>%</span>
                <span class="badge <%= slaAttainment >= 85 ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning-emphasis' %> border">
                  <%= slaAttainment >= 85 ? 'Target Met' : 'Needs Review' %>
                </span>
              </div>
              <div class="text-muted" style="font-size: 0.75rem;">SLA Attainment Rate (Last 30 Days)</div>
            </div>
          </div>
        </div>
        <% } %>

        <% if (avgResolutionHours !== null) { %>
        <div class="col-md-6 col-lg-4">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary p-2" style="width: 44px; height: 44px;">
              <i class="bi bi-hourglass-split fs-5"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fs-5 fw-bold text-dark"><%= avgResolutionHours %> <span class="fs-6 fw-normal text-muted">hours</span></div>
              <div class="text-muted" style="font-size: 0.75rem;">Average Time to Resolution (Resolved tickets)</div>
            </div>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- 2-Column Operational Workspace -->
      <div class="row g-4">
        <!-- Left: My Assigned Tickets -->
        <div class="col-lg-6">
          <div class="wf-card h-100">
            <div class="wf-card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-primary"></i>
                <span class="fw-semibold small">My Assigned Work</span>
              </div>
              <span class="badge bg-light text-secondary border small"><%= myAssigned.length %> assigned</span>
            </div>
            <div class="p-0">
              <% if (!myAssigned || myAssigned.length === 0) { %>
                <div class="p-4 text-center text-muted">
                  <i class="bi bi-check2-circle fs-3 text-secondary d-block mb-1"></i>
                  <span class="small">No operational tickets currently assigned to you.</span>
                </div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="wf-table mb-0">
                    <thead>
                      <tr>
                        <th>Ticket</th>
                        <th>Summary</th>
                        <th>Priority</th>
                        <th class="text-end">Due</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% myAssigned.forEach(t => { %>
                      <tr class="ticket-row" data-href="/tickets/<%= t._id %>">
                        <td class="ticket-code">
                          <a href="/tickets/<%= t._id %>" class="text-decoration-none"><%= t.ticketNumber %></a>
                        </td>
                        <td>
                          <div class="fw-medium text-dark text-truncate" style="max-width: 220px;"><%= t.title %></div>
                          <div class="text-muted" style="font-size: 0.6875rem;"><%= t.reportingDepartmentId ? t.reportingDepartmentId.name : 'General' %></div>
                        </td>
                        <td>
                          <span class="wf-badge badge-priority-<%= t.priority %> text-uppercase">
                            <span class="status-dot"></span>
                            <%= t.priority %>
                          </span>
                        </td>
                        <td class="text-end">
                          <% if (t.dueAt && new Date(t.dueAt) < new Date()) { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small fw-semibold">Overdue</span>
                          <% } else if (t.dueAt) { %>
                            <span class="text-muted small"><%= new Date(t.dueAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></span>
                          <% } else { %>
                            <span class="text-muted small">—</span>
                          <% } %>
                        </td>
                      </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
            <div class="wf-card-footer d-flex justify-content-between align-items-center">
              <a href="/tickets?status=assigned" class="small text-decoration-none fw-medium text-primary">
                View all assigned tickets <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Recent Operational Updates -->
        <div class="col-lg-6">
          <div class="wf-card h-100">
            <div class="wf-card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-activity text-secondary"></i>
                <span class="fw-semibold small">Recently Updated Tickets</span>
              </div>
              <a href="/tickets" class="small text-decoration-none text-muted">View all</a>
            </div>
            <div class="p-0">
              <% if (!recentlyUpdated || recentlyUpdated.length === 0) { %>
                <div class="p-4 text-center text-muted">
                  <span class="small">No recent ticket updates.</span>
                </div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="wf-table mb-0">
                    <thead>
                      <tr>
                        <th>Ticket</th>
                        <th>Summary</th>
                        <th class="text-end">Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% recentlyUpdated.forEach(t => { %>
                      <tr class="ticket-row" data-href="/tickets/<%= t._id %>">
                        <td class="ticket-code">
                          <a href="/tickets/<%= t._id %>" class="text-decoration-none"><%= t.ticketNumber %></a>
                        </td>
                        <td>
                          <div class="fw-medium text-dark text-truncate" style="max-width: 250px;"><%= t.title %></div>
                          <div class="text-muted" style="font-size: 0.6875rem;"><%= t.reportingDepartmentId ? t.reportingDepartmentId.name : '—' %></div>
                        </td>
                        <td class="text-end">
                          <span class="wf-badge badge-status-<%= t.status %>">
                            <span class="status-dot"></span>
                            <%= t.status.replace(/_/g, ' ') %>
                          </span>
                        </td>
                      </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Bottom: Operational Alerts & Notifications -->
        <% if (notifications && notifications.length > 0) { %>
        <div class="col-12">
          <div class="wf-card">
            <div class="wf-card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bell text-warning"></i>
                <span class="fw-semibold small">Operational Alerts &amp; Notifications</span>
              </div>
              <span class="badge bg-warning-subtle text-warning-emphasis border"><%= notifications.length %> unread</span>
            </div>
            <div class="p-0">
              <ul class="list-group list-group-flush small">
                <% notifications.forEach(n => { %>
                <li class="list-group-item px-3 py-2 d-flex justify-content-between align-items-center">
                  <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle text-primary mt-1"></i>
                    <div>
                      <div class="fw-semibold text-dark"><%= n.title %></div>
                      <div class="text-muted"><%= n.message %></div>
                    </div>
                  </div>
                  <% if (n.ticketId) { %>
                  <a href="/tickets/<%= n.ticketId %>" class="btn btn-sm btn-outline-primary ms-3 text-nowrap">View Ticket</a>
                  <% } %>
                </li>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
