<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card stat-card h-100 border-0" style="background:#e8f0fe">
          <div class="card-body">
            <div class="stat-value text-primary"><%= totalOpen %></div>
            <div class="stat-label">Total Open Tickets</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card stat-card h-100 border-0 <%= overdueCount > 0 ? 'overdue-indicator' : '' %>" style="background:#fce8e6">
          <div class="card-body">
            <div class="stat-value text-danger"><%= overdueCount %></div>
            <div class="stat-label">Overdue Tickets</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card stat-card h-100 border-0" style="background:#fef9e7">
          <div class="card-body">
            <div class="stat-value text-warning"><%= unassigned %></div>
            <div class="stat-label">Unassigned Tickets</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card stat-card h-100 border-0" style="background:#fce8e6">
          <div class="card-body">
            <div class="stat-value text-danger"><%= critical %></div>
            <div class="stat-label">Critical Issues</div>
          </div>
        </div>
      </div>
    </div>

    <!-- SLA and Avg Resolution -->
    <% if (slaAttainment !== null || avgResolutionHours !== null) { %>
    <div class="row g-3 mb-4">
      <% if (slaAttainment !== null) { %>
      <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="text-success fs-2"><i class="bi bi-check2-circle"></i></div>
            <div>
              <div class="fw-bold fs-4"><%= slaAttainment %>%</div>
              <div class="text-muted small">SLA Attainment (Last 30 Days)</div>
            </div>
          </div>
        </div>
      </div>
      <% } %>
      <% if (avgResolutionHours !== null) { %>
      <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="text-info fs-2"><i class="bi bi-clock-history"></i></div>
            <div>
              <div class="fw-bold fs-4"><%= avgResolutionHours %> hours</div>
              <div class="text-muted small">Average Resolution Time (closed tickets)</div>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

    <div class="row g-4">
      <!-- My Assigned Tickets -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header fw-semibold bg-white border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-person-check me-2 text-primary"></i>My Assigned Tickets</span>
            <span class="badge bg-light text-dark"><%= myAssigned.length %></span>
          </div>
          <div class="card-body p-0">
            <% if (myAssigned.length === 0) { %>
            <div class="p-4 text-muted text-center small">No tickets currently assigned to you.</div>
            <% } else { %>
            <ul class="list-group list-group-flush">
              <% myAssigned.forEach(t => { %>
              <li class="list-group-item py-2 px-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <a href="/tickets/<%= t._id %>" class="fw-semibold text-decoration-none small"><%= t.ticketNumber %></a>
                    <div class="text-muted small text-truncate" style="max-width:240px"><%= t.title %></div>
                  </div>
                  <div class="text-end">
                    <span class="badge badge-priority-<%= t.priority %>"><%= t.priority %></span>
                    <% if (t.dueAt && new Date(t.dueAt) < new Date()) { %>
                    <span class="badge bg-danger ms-1">Overdue</span>
                    <% } %>
                  </div>
                </div>
              </li>
              <% }) %>
            </ul>
            <% } %>
          </div>
          <div class="card-footer bg-white border-top-0">
            <a href="/tickets?status=assigned" class="btn btn-sm btn-outline-primary">View all assigned</a>
          </div>
        </div>
      </div>

      <!-- Recently Updated -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header fw-semibold bg-white border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-arrow-clockwise me-2 text-secondary"></i>Recently Updated Tickets</span>
          </div>
          <div class="card-body p-0">
            <% if (recentlyUpdated.length === 0) { %>
            <div class="p-4 text-muted text-center small">No recent activity.</div>
            <% } else { %>
            <ul class="list-group list-group-flush">
              <% recentlyUpdated.forEach(t => { %>
              <li class="list-group-item py-2 px-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <a href="/tickets/<%= t._id %>" class="fw-semibold text-decoration-none small"><%= t.ticketNumber %></a>
                    <div class="text-muted small text-truncate" style="max-width:240px"><%= t.title %></div>
                  </div>
                  <span class="badge badge-status-<%= t.status %>"><%= t.status.replace('_',' ') %></span>
                </div>
              </li>
              <% }) %>
            </ul>
            <% } %>
          </div>
          <div class="card-footer bg-white border-top-0">
            <a href="/tickets" class="btn btn-sm btn-outline-secondary">View all tickets</a>
          </div>
        </div>
      </div>

      <!-- Notifications -->
      <% if (notifications && notifications.length > 0) { %>
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header fw-semibold bg-white border-bottom">
            <i class="bi bi-bell me-2 text-warning"></i>Operational Alerts & Notifications
          </div>
          <ul class="list-group list-group-flush">
            <% notifications.forEach(n => { %>
            <li class="list-group-item py-2 px-3 d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-semibold small"><%= n.title %></div>
                <div class="text-muted small"><%= n.message %></div>
              </div>
              <% if (n.ticketId) { %>
              <a href="/tickets/<%= n.ticketId %>" class="btn btn-sm btn-outline-primary ms-3">View</a>
              <% } %>
            </li>
            <% }) %>
          </ul>
        </div>
      </div>
      <% } %>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
