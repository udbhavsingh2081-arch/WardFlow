<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Worker Dashboard — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <!-- Worker Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
          <h4 class="fw-bold mb-1">
            <i class="bi bi-tools text-primary me-2"></i>Worker Task Queue
          </h4>
          <p class="text-muted small mb-0">Assigned technician workspace: view active tasks, update status, and track repairs.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/qr/staff" class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-qr-code-scan me-2"></i>Staff QR Scanner
          </a>
          <a href="/tickets?scope=history" class="btn btn-outline-secondary px-3">
            <i class="bi bi-clock-history me-1"></i>Task History
          </a>
        </div>
      </div>

      <!-- KPI Metrics -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-4">
              <i class="bi bi-list-task"></i>
            </div>
            <div>
              <div class="text-muted small fw-medium">Active Queue</div>
              <div class="fs-4 fw-bold text-dark"><%= assignedActiveCount %></div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 fs-4">
              <i class="bi bi-alarm"></i>
            </div>
            <div>
              <div class="text-muted small fw-medium">Overdue Tasks</div>
              <div class="fs-4 fw-bold text-danger"><%= assignedOverdueCount %></div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3 fs-4">
              <i class="bi bi-exclamation-octagon"></i>
            </div>
            <div>
              <div class="text-muted small fw-medium">Critical Priority</div>
              <div class="fs-4 fw-bold text-warning"><%= assignedCriticalCount %></div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-4">
              <i class="bi bi-check2-circle"></i>
            </div>
            <div>
              <div class="text-muted small fw-medium">Completed (Month)</div>
              <div class="fs-4 fw-bold text-success"><%= resolvedThisMonthCount %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Active Tasks Table -->
      <div class="wf-card mb-4">
        <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span class="fw-semibold"><i class="bi bi-lightning-charge me-2 text-primary"></i>Immediate Assigned Tasks (<%= activeTasks ? activeTasks.length : 0 %>)</span>
          <span class="text-muted small">Prioritized by SLA Deadline</span>
        </div>
        <div class="card-body p-0">
          <% if (!activeTasks || activeTasks.length === 0) { %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-emoji-smile fs-1 text-success d-block mb-3"></i>
              <h6 class="fw-bold text-dark mb-1">Your task queue is clear</h6>
              <p class="small text-muted mb-0">No active repair tickets are assigned to you right now.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                  <tr>
                    <th class="ps-4">Ticket</th>
                    <th>Issue & Description</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>SLA Deadline</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Quick Action</th>
                  </tr>
                </thead>
                <tbody class="small">
                  <% activeTasks.forEach(t => { 
                    const isOverdue = t.dueAt && new Date(t.dueAt) < new Date();
                  %>
                    <tr class="ticket-row" data-href="/tickets/<%= t._id %>">
                      <td class="ps-4 fw-semibold text-primary">
                        <code><%= t.ticketNumber %></code>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark text-truncate" style="max-width: 250px;"><%= t.title %></div>
                        <div class="text-muted small text-truncate" style="max-width: 250px;"><%= t.reportingDepartmentId?.name || 'Department' %></div>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border text-capitalize"><%= t.category %></span>
                      </td>
                      <td>
                        <span class="badge badge-priority-<%= t.priority %> text-uppercase">
                          <%= t.priority %>
                        </span>
                      </td>
                      <td>
                        <% if (t.dueAt) { %>
                          <span class="<%= isOverdue ? 'text-danger fw-bold' : 'text-muted' %>">
                            <%= new Date(t.dueAt).toLocaleDateString() %> <%= new Date(t.dueAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                            <% if (isOverdue) { %>
                              <i class="bi bi-exclamation-triangle-fill ms-1" title="SLA Breached"></i>
                            <% } %>
                          </span>
                        <% } else { %>
                          <span class="text-muted">—</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge badge-status-<%= t.status %>">
                          <%= t.status.replace('_', ' ') %>
                        </span>
                      </td>
                      <td class="text-end pe-4" onclick="event.stopPropagation();">
                        <div class="d-flex justify-content-end gap-1">
                          <% if (t.status === 'assigned') { %>
                            <form method="POST" action="/tickets/<%= t._id %>/status" class="d-inline">
                              <input type="hidden" name="status" value="in_progress" />
                              <button type="submit" class="btn btn-sm btn-primary py-1 px-2" title="Accept & Start Work">
                                <i class="bi bi-play-fill me-1"></i>Start
                              </button>
                            </form>
                          <% } else if (t.status === 'in_progress') { %>
                            <a href="/tickets/<%= t._id %>#resolveSection" class="btn btn-sm btn-success py-1 px-2" title="Mark as resolved">
                              <i class="bi bi-check2 me-1"></i>Resolve
                            </a>
                            <a href="/tickets/<%= t._id %>" class="btn btn-sm btn-outline-warning py-1 px-2" title="Report Blocker">
                              <i class="bi bi-pause-fill"></i>
                            </a>
                          <% } else if (t.status === 'blocked') { %>
                            <form method="POST" action="/tickets/<%= t._id %>/status" class="d-inline">
                              <input type="hidden" name="status" value="in_progress" />
                              <button type="submit" class="btn btn-sm btn-outline-primary py-1 px-2" title="Resume Work">
                                <i class="bi bi-arrow-repeat me-1"></i>Resume
                              </button>
                            </form>
                          <% } %>
                          <a href="/tickets/<%= t._id %>" class="btn btn-sm btn-light border py-1 px-2">
                            <i class="bi bi-chevron-right"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Recently Completed Tasks -->
      <% if (recentlyCompleted && recentlyCompleted.length > 0) { %>
        <div class="wf-card">
          <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-check-all me-2 text-success"></i>Recently Completed Tasks</span>
            <a href="/tickets?scope=history" class="small text-decoration-none">View All History</a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                  <tr>
                    <th class="ps-4">Ticket</th>
                    <th>Title</th>
                    <th>Resolution Summary</th>
                    <th>Resolved At</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Detail</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentlyCompleted.forEach(t => { %>
                    <tr class="ticket-row" data-href="/tickets/<%= t._id %>">
                      <td class="ps-4 fw-semibold"><code><%= t.ticketNumber %></code></td>
                      <td><%= t.title %></td>
                      <td class="text-muted text-truncate" style="max-width: 300px;"><%= t.resolutionSummary || '—' %></td>
                      <td class="text-muted"><%= t.resolvedAt ? new Date(t.resolvedAt).toLocaleDateString() : '—' %></td>
                      <td><span class="badge badge-status-<%= t.status %>"><%= t.status %></span></td>
                      <td class="text-end pe-4">
                        <a href="/tickets/<%= t._id %>" class="btn btn-sm btn-outline-secondary py-0 px-2">View</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
