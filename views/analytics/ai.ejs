<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <!-- Dashboard Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <h4 class="fw-bold mb-0">
              <i class="bi bi-stars text-primary me-2"></i>Gemini AI Operational Analytics
            </h4>
            <span class="badge <%= aiGenerated ? 'bg-primary' : 'bg-secondary' %> text-uppercase" style="font-size: 0.65rem;">
              <%= modelUsed %>
            </span>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size: 0.65rem;">
              <i class="bi bi-shield-check me-1"></i>Privacy-Safe (Aggregates Only)
            </span>
          </div>
          <p class="text-muted small mb-0">Real-time MongoDB aggregation pipelines synthesized with backend Gemini intelligence for hospital management.</p>
        </div>
        <div class="d-flex gap-2">
          <button onclick="window.location.reload();" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh Insights
          </button>
          <a href="/analytics" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-bar-chart-line me-1"></i>Standard SLA Report
          </a>
        </div>
      </div>

      <% if (fallbackNotice) { %>
        <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-4">
          <i class="bi bi-info-circle-fill me-2 fs-5"></i>
          <div><%= fallbackNotice %></div>
        </div>
      <% } %>

      <!-- Executive Summary Card -->
      <div class="wf-card mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #f8fafc;">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-2 mb-2 text-warning">
            <i class="bi bi-lightbulb-fill fs-5"></i>
            <h6 class="fw-bold mb-0 text-uppercase tracking-wider" style="letter-spacing: 0.05em; font-size: 0.8rem;">Executive Operational Synthesis</h6>
          </div>
          <p class="mb-0 fs-6 lh-base text-light opacity-90">
            <%= insights.executiveSummary %>
          </p>
        </div>
      </div>

      <!-- Real MongoDB Aggregate Metric Cards -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3">
            <div class="text-muted small fw-medium">Active Requests</div>
            <div class="fs-4 fw-bold text-dark mt-1"><%= aggregates.kpis.totalOpen %></div>
            <div class="text-muted" style="font-size: 0.7rem;">Out of <%= aggregates.kpis.total %> total recorded</div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3 <%= aggregates.kpis.totalOverdue > 0 ? 'border-danger border-opacity-50' : '' %>">
            <div class="text-muted small fw-medium">Overdue SLA Incidents</div>
            <div class="fs-4 fw-bold text-danger mt-1"><%= aggregates.kpis.totalOverdue %></div>
            <div class="text-muted" style="font-size: 0.7rem;">Exceeded target deadline</div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3">
            <div class="text-muted small fw-medium">SLA Breach Ratio</div>
            <div class="fs-4 fw-bold text-warning mt-1"><%= aggregates.kpis.overallBreachRate %>%</div>
            <div class="text-muted" style="font-size: 0.7rem;">Hospital-wide ratio</div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wf-card p-3">
            <div class="text-muted small fw-medium">Unassigned Incidents</div>
            <div class="fs-4 fw-bold text-primary mt-1"><%= aggregates.kpis.unassigned %></div>
            <div class="text-muted" style="font-size: 0.7rem;">Needs technician dispatch</div>
          </div>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <!-- Left Column: Department Bottlenecks & Risk Forecast -->
        <div class="col-lg-7">
          <!-- Department Bottlenecks Table -->
          <div class="wf-card mb-4">
            <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
              <span class="fw-semibold text-dark"><i class="bi bi-building-exclamation me-2 text-danger"></i>Department Bottleneck Aggregation</span>
              <span class="text-muted small">Real MongoDB Aggregates</span>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                  <thead class="table-light">
                    <tr>
                      <th class="ps-3">Department</th>
                      <th>Total</th>
                      <th>Active</th>
                      <th>Overdue</th>
                      <th>Breach %</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!aggregates.departmentStats || aggregates.departmentStats.length === 0) { %>
                      <tr><td colspan="5" class="text-center py-4 text-muted">No department data recorded yet.</td></tr>
                    <% } else { %>
                      <% aggregates.departmentStats.forEach(d => { %>
                        <tr>
                          <td class="ps-3 fw-semibold">
                            <%= d.departmentName %>
                            <span class="text-muted fw-normal" style="font-size: 0.7rem;">(<%= d.departmentCode %>)</span>
                          </td>
                          <td><%= d.total %></td>
                          <td><%= d.openCount %></td>
                          <td>
                            <% if (d.overdueCount > 0) { %>
                              <span class="text-danger fw-bold"><%= d.overdueCount %></span>
                            <% } else { %>
                              <span class="text-muted">0</span>
                            <% } %>
                          </td>
                          <td>
                            <% if (d.breachRate > 0) { %>
                              <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                  <div class="progress-bar bg-danger" role="progressbar" style="width: <%= Math.min(d.breachRate, 100) %>%;"></div>
                                </div>
                                <span class="fw-bold text-danger"><%= d.breachRate %>%</span>
                              </div>
                            <% } else { %>
                              <span class="text-success small"><i class="bi bi-check-circle me-1"></i>0%</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Risk Forecast Cards -->
          <div class="wf-card mb-4">
            <div class="card-header bg-transparent py-3 border-bottom">
              <span class="fw-semibold text-dark"><i class="bi bi-shield-exclamation me-2 text-warning"></i>Operational Risk Forecast</span>
            </div>
            <div class="card-body p-3">
              <% if (!insights.riskForecast || insights.riskForecast.length === 0) { %>
                <div class="text-muted small">No immediate operational risks flagged.</div>
              <% } else { %>
                <div class="d-flex flex-column gap-3">
                  <% insights.riskForecast.forEach(rf => { %>
                    <div class="p-3 rounded-2 border bg-light small">
                      <div class="fw-bold text-danger mb-1">
                        <i class="bi bi-exclamation-triangle me-1"></i><%= rf.risk %>
                      </div>
                      <div class="text-secondary"><%= rf.impact %></div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Identified Bottlenecks List -->
          <div class="wf-card">
            <div class="card-header bg-transparent py-3 border-bottom">
              <span class="fw-semibold text-dark"><i class="bi bi-funnel me-2 text-primary"></i>Synthesized Bottleneck Insights</span>
            </div>
            <div class="card-body p-3">
              <% if (!insights.bottlenecks || insights.bottlenecks.length === 0) { %>
                <div class="text-muted small">No major bottlenecks noted.</div>
              <% } else { %>
                <div class="list-group list-group-flush small">
                  <% insights.bottlenecks.forEach(b => { %>
                    <div class="list-group-item px-0 py-2 border-bottom">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-dark"><%= b.area %></span>
                        <span class="badge <%= b.severity === 'High' ? 'bg-danger' : (b.severity === 'Medium' ? 'bg-warning text-dark' : 'bg-info') %>">
                          <%= b.severity %> Severity
                        </span>
                      </div>
                      <div class="text-muted"><%= b.description %></div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Right Column: Staffing Rebalancing & Action Items -->
        <div class="col-lg-5">
          <!-- Priority Action Items -->
          <div class="wf-card mb-4 border-primary border-opacity-25">
            <div class="card-header bg-primary bg-opacity-10 py-3 border-bottom border-primary border-opacity-25">
              <span class="fw-bold text-primary"><i class="bi bi-check-square-fill me-2"></i>Immediate Action Items for Operations</span>
            </div>
            <div class="card-body p-3">
              <% if (!insights.actionItems || insights.actionItems.length === 0) { %>
                <div class="text-muted small">All operational parameters within expected tolerances.</div>
              <% } else { %>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                  <% insights.actionItems.forEach((item, index) => { %>
                    <li class="d-flex gap-2 align-items-start">
                      <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center mt-1" style="width: 20px; height: 20px; flex-shrink: 0; font-size: 0.65rem;">
                        <%= index + 1 %>
                      </span>
                      <span class="text-dark lh-sm"><%= item %></span>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
          </div>

          <!-- Staffing Rebalancing Suggestions -->
          <div class="wf-card mb-4">
            <div class="card-header bg-transparent py-3 border-bottom">
              <span class="fw-semibold text-dark"><i class="bi bi-people-fill me-2 text-primary"></i>Staffing Rebalancing Directives</span>
            </div>
            <div class="card-body p-3 small">
              <% if (!insights.staffingRebalancing || insights.staffingRebalancing.length === 0) { %>
                <div class="text-muted">Staffing loads are currently optimal.</div>
              <% } else { %>
                <ul class="mb-3 ps-3 text-secondary">
                  <% insights.staffingRebalancing.forEach(s => { %>
                    <li class="mb-1"><%= s %></li>
                  <% }) %>
                </ul>
              <% } %>

              <!-- Technician Capacity Overview -->
              <h6 class="fw-semibold text-muted mb-2 pt-2 border-top" style="font-size: 0.75rem;">TECHNICIAN WORKLOAD DISTRIBUTION</h6>
              <% if (!aggregates.workerStats || aggregates.workerStats.length === 0) { %>
                <div class="text-muted small">No technician allocations recorded yet.</div>
              <% } else { %>
                <ul class="list-group list-group-flush">
                  <% aggregates.workerStats.forEach(w => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                      <div>
                        <div class="fw-semibold text-dark"><%= w.workerName %></div>
                        <div class="text-muted" style="font-size: 0.6875rem;"><%= w.role.replace('_', ' ') %></div>
                      </div>
                      <div class="text-end">
                        <span class="badge <%= w.activeCount > 3 ? 'bg-warning text-dark' : 'bg-light text-dark border' %>">
                          <%= w.activeCount %> active
                        </span>
                        <% if (w.overdueCount > 0) { %>
                          <span class="badge bg-danger ms-1"><%= w.overdueCount %> overdue</span>
                        <% } %>
                      </div>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
          </div>

          <!-- Incident Category Distribution -->
          <div class="wf-card">
            <div class="card-header bg-transparent py-3 border-bottom">
              <span class="fw-semibold text-dark"><i class="bi bi-pie-chart-fill me-2 text-secondary"></i>Category Concentration</span>
            </div>
            <div class="card-body p-3">
              <% if (!aggregates.categoryStats || aggregates.categoryStats.length === 0) { %>
                <div class="text-muted small">No incidents recorded.</div>
              <% } else { %>
                <% 
                  const totalIncidents = aggregates.categoryStats.reduce((sum, c) => sum + c.count, 0);
                %>
                <div class="d-flex flex-column gap-2 small">
                  <% aggregates.categoryStats.forEach(c => { 
                    const pct = totalIncidents > 0 ? Math.round((c.count / totalIncidents) * 100) : 0;
                  %>
                    <div>
                      <div class="d-flex justify-content-between text-muted mb-1" style="font-size: 0.75rem;">
                        <span class="fw-semibold text-dark text-capitalize"><%= c._id %></span>
                        <span><%= c.count %> incidents (<%= pct %>%)</span>
                      </div>
                      <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= pct %>%;"></div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
