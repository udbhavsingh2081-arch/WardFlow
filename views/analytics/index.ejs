<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Escalation & Bottleneck Analytics — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
  <style>
    .ai-summary-card {
      background: linear-gradient(145deg, #ffffff 0%, #f7faff 100%);
      border: 1px solid #cce0ff;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(13, 110, 253, 0.08);
      transition: all 0.3s ease;
    }
    .ai-pill-card {
      border-radius: 8px;
      padding: 0.75rem 1rem;
      border: 1px solid rgba(0,0,0,0.06);
      background: #fff;
    }
    .chart-card {
      background: #ffffff;
      border: 1px solid #e9ecef;
      border-radius: 10px;
    }
    .btn-ai-sparkle {
      background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
      color: #000;
      font-weight: 600;
      border: none;
      box-shadow: 0 2px 6px rgba(253, 126, 20, 0.25);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .btn-ai-sparkle:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(253, 126, 20, 0.35);
      color: #000;
    }
  </style>
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h5 class="fw-bold mb-1"><i class="bi bi-bar-chart-line text-primary me-2"></i>Escalation &amp; Bottleneck Analytics</h5>
          <p class="text-muted small mb-0">Visual department workload, response times, and AI operational summary.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" id="btnAiExplain" class="btn btn-ai-sparkle btn-sm px-3 py-1 d-flex align-items-center gap-2" onclick="explainWithAi()">
            <i class="bi bi-stars fs-6"></i>
            <span>Explain with AI</span>
          </button>
          <a href="/api/reports/export?from=<%= filters.from %>&to=<%= filters.to %>" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-cloud-arrow-down me-1"></i>Export CSV
          </a>
        </div>
      </div>

      <!-- AI Operational Summary Container (Dynamic) -->
      <div id="aiSummaryBox" class="mb-4" style="display: none;">
        <div class="ai-summary-card p-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-warning text-dark px-2 py-1 fs-7 fw-semibold">
                <i class="bi bi-stars me-1"></i>AI Summary
              </span>
              <span id="aiModelBadge" class="text-muted small">Generated in plain language</span>
            </div>
            <button type="button" class="btn-close btn-sm" onclick="closeAiSummary()" aria-label="Close"></button>
          </div>

          <div id="aiHeadlineAlert" class="alert mb-3 fw-semibold py-2 px-3 d-flex align-items-center gap-2">
            <i id="aiHeadlineIcon" class="bi fs-5"></i>
            <span id="aiHeadlineText">Analyzing hospital workload...</span>
          </div>

          <p id="aiSummaryText" class="text-secondary mb-3 small" style="line-height: 1.6;"></p>

          <div id="aiPointsContainer" class="row g-2 mb-3">
            <!-- Dynamically populated highlight tiles -->
          </div>

          <div id="aiActionBox" class="p-3 rounded bg-light border small text-dark d-flex align-items-start gap-2">
            <i class="bi bi-arrow-right-circle-fill text-primary fs-6 mt-1 flex-shrink-0"></i>
            <div>
              <strong>Recommended Action:</strong>
              <span id="aiActionText" class="ms-1 text-secondary"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Filter Controls -->
      <div class="wf-card mb-4">
        <div class="p-3">
          <form method="GET" action="/analytics" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
              <label class="form-label mb-1 small text-muted">From Date</label>
              <input type="date" class="form-control form-control-sm" name="from" value="<%= filters.from %>">
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label mb-1 small text-muted">To Date</label>
              <input type="date" class="form-control form-control-sm" name="to" value="<%= filters.to %>">
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label mb-1 small text-muted">Department</label>
              <select class="form-select form-select-sm" name="departmentId">
                <option value="">All Departments</option>
                <% departments.forEach(dept => { %>
                  <option value="<%= dept._id %>" <%= filters.departmentId === dept._id.toString() ? 'selected' : '' %>>
                    <%= dept.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label mb-1 small text-muted">Category</label>
              <select class="form-select form-select-sm text-capitalize" name="category">
                <option value="">All Categories</option>
                <% CATEGORIES.forEach(cat => { %>
                  <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label mb-1 small text-muted">Priority</label>
              <select class="form-select form-select-sm text-capitalize" name="priority">
                <option value="">All Priorities</option>
                <% PRIORITIES.forEach(pri => { %>
                  <option value="<%= pri %>" <%= filters.priority === pri ? 'selected' : '' %>><%= pri %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
              <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                <i class="bi bi-funnel me-1"></i>Filter
              </button>
              <a href="/analytics" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Key Operational Metrics -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-2">
          <div class="wf-kpi-tile">
            <div class="kpi-label">
              <span>Total Reported</span>
              <i class="bi bi-file-earmark-text text-secondary"></i>
            </div>
            <div class="kpi-number text-primary"><%= kpis.totalTickets %></div>
            <div class="kpi-footer">Selected period</div>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <div class="wf-kpi-tile <%= kpis.overdueOpenCount > 0 ? 'kpi-danger' : '' %>">
            <div class="kpi-label">
              <span class="<%= kpis.overdueOpenCount > 0 ? 'text-danger' : '' %>">Currently Overdue</span>
              <i class="bi bi-alarm <%= kpis.overdueOpenCount > 0 ? 'text-danger' : 'text-secondary' %>"></i>
            </div>
            <div class="kpi-number <%= kpis.overdueOpenCount > 0 ? 'text-danger' : '' %>"><%= kpis.overdueOpenCount %></div>
            <div class="kpi-footer">Active tickets past SLA</div>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <div class="wf-kpi-tile <%= kpis.slaBreachRate > 20 ? 'kpi-danger' : 'kpi-success' %>">
            <div class="kpi-label">
              <span>SLA Breach Rate</span>
              <i class="bi bi-speedometer <%= kpis.slaBreachRate > 20 ? 'text-danger' : 'text-success' %>"></i>
            </div>
            <div class="kpi-number <%= kpis.slaBreachRate > 20 ? 'text-danger' : 'text-success' %>"><%= kpis.slaBreachRate %>%</div>
            <div class="kpi-footer"><%= kpis.breachedSLACount %> of <%= kpis.eligibleSLACount %> eligible</div>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <div class="wf-kpi-tile">
            <div class="kpi-label">
              <span>Avg Time to Assign</span>
              <i class="bi bi-person-check text-secondary"></i>
            </div>
            <div class="kpi-number text-dark">
              <%= kpis.avgAssignmentDelayHours !== null ? kpis.avgAssignmentDelayHours + 'h' : '—' %>
            </div>
            <div class="kpi-footer"><%= kpis.assignmentCount %> assigned</div>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <div class="wf-kpi-tile">
            <div class="kpi-label">
              <span>Avg Time to Fix</span>
              <i class="bi bi-hourglass-split text-secondary"></i>
            </div>
            <div class="kpi-number text-dark">
              <%= kpis.avgResolutionHours !== null ? kpis.avgResolutionHours + 'h' : '—' %>
            </div>
            <div class="kpi-footer"><%= kpis.resolvedCount %> resolved</div>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <div class="wf-kpi-tile <%= kpis.awaitingAssignmentCount > 0 ? 'kpi-warning' : '' %>">
            <div class="kpi-label">
              <span class="<%= kpis.awaitingAssignmentCount > 0 ? 'text-warning-emphasis' : '' %>">Needs Worker</span>
              <i class="bi bi-person-x <%= kpis.awaitingAssignmentCount > 0 ? 'text-warning' : 'text-secondary' %>"></i>
            </div>
            <div class="kpi-number <%= kpis.awaitingAssignmentCount > 0 ? 'text-warning-emphasis' : '' %>"><%= kpis.awaitingAssignmentCount %></div>
            <div class="kpi-footer">Open unassigned</div>
          </div>
        </div>
      </div>

      <!-- Graphical Data Charts (Chart.js) -->
      <div class="row g-4 mb-4">
        <!-- Left: Department Workload & Overdue Chart -->
        <div class="col-lg-7">
          <div class="chart-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <span class="fw-semibold small text-dark"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Department Workload &amp; Overdue Issues</span>
                <div class="text-muted" style="font-size: 0.72rem;">Compare active backlog and overdue requests per department</div>
              </div>
              <span class="badge bg-light text-secondary border small">Bar Chart</span>
            </div>
            <div style="position: relative; height: 260px;">
              <canvas id="deptWorkloadChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Right: Category Distribution Doughnut Chart -->
        <div class="col-lg-5">
          <div class="chart-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <span class="fw-semibold small text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Issues by Category</span>
                <div class="text-muted" style="font-size: 0.72rem;">Volume breakdown across equipment, electrical, plumbing, etc.</div>
              </div>
              <span class="badge bg-light text-secondary border small">Doughnut</span>
            </div>
            <div style="position: relative; height: 260px;">
              <canvas id="categoryDistChart"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- Department Operational Bottlenecks Table -->
      <div class="wf-table-container mb-4">
        <div class="wf-card-header d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-semibold small"><i class="bi bi-diagram-3 me-2 text-primary"></i>Department Operational Bottlenecks</span>
            <div class="text-muted" style="font-size: 0.72rem;">Ranked by overdue volume and resolution delays</div>
          </div>
          <span class="badge bg-light text-secondary border small"><%= departmentBottlenecks.length %> Departments</span>
        </div>
        <div class="table-responsive">
          <table class="wf-table">
            <thead>
              <tr>
                <th class="ps-4">Department</th>
                <th class="text-center">Total Issues</th>
                <th class="text-center">Active Backlog</th>
                <th class="text-center">Overdue Open</th>
                <th class="text-center">SLA Breach Rate</th>
                <th class="text-center">Avg Assign Delay</th>
                <th class="text-center pe-4">Avg Resolution Time</th>
              </tr>
            </thead>
            <tbody>
              <% if (!departmentBottlenecks || departmentBottlenecks.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">No department data found for the selected period.</td>
                </tr>
              <% } else { %>
                <% departmentBottlenecks.forEach(dept => { %>
                  <tr>
                    <td class="ps-4 fw-semibold text-dark">
                      <%= dept.name %>
                      <% if (dept.code && dept.code !== '—') { %>
                        <span class="badge bg-light text-secondary border font-monospace ms-1"><%= dept.code %></span>
                      <% } %>
                    </td>
                    <td class="text-center fw-medium"><%= dept.ticketCount %></td>
                    <td class="text-center">
                      <span class="badge bg-light text-secondary border"><%= dept.openBacklog %></span>
                    </td>
                    <td class="text-center">
                      <% if (dept.overdueCount > 0) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold"><%= dept.overdueCount %></span>
                      <% } else { %>
                        <span class="text-muted small">0</span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <% if (dept.slaEligible === 0) { %>
                        <span class="text-muted small">—</span>
                      <% } else if (dept.slaBreachRate > 25) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= dept.slaBreachRate %>%</span>
                      <% } else if (dept.slaBreachRate > 10) { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><%= dept.slaBreachRate %>%</span>
                      <% } else { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle"><%= dept.slaBreachRate %>%</span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <% if (dept.avgAssignHours !== null) { %>
                        <%= dept.avgAssignHours %> hrs
                      <% } else { %>
                        <span class="text-muted small">—</span>
                      <% } %>
                    </td>
                    <td class="text-center pe-4">
                      <% if (dept.avgResolveHours !== null) { %>
                        <%= dept.avgResolveHours %> hrs
                      <% } else { %>
                        <span class="text-muted small">—</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="wf-card-footer small text-muted" style="font-size: 0.72rem;">
          <i class="bi bi-info-circle me-1"></i>
          <strong>Guide:</strong> <em>Active Backlog</em> is open or in-progress work. <em>SLA Breach Rate</em> reflects requests that passed target deadlines.
        </div>
      </div>

      <!-- Category Breakdown & Target Times -->
      <div class="row g-4 mb-4">
        <div class="col-lg-6">
          <div class="wf-table-container h-100">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-pie-chart me-2 text-primary"></i>Category SLA Analysis</span>
            </div>
            <div class="table-responsive">
              <table class="wf-table">
                <thead>
                  <tr>
                    <th class="ps-3">Category</th>
                    <th class="text-center">Tickets</th>
                    <th class="text-center">Open</th>
                    <th class="text-center">Breach Rate</th>
                    <th class="text-end pe-3">Avg Resolution</th>
                  </tr>
                </thead>
                <tbody>
                  <% categoryStats.forEach(cat => { %>
                    <tr>
                      <td class="ps-3 fw-semibold text-capitalize text-dark"><%= cat.category %></td>
                      <td class="text-center"><%= cat.count %></td>
                      <td class="text-center"><%= cat.openCount %></td>
                      <td class="text-center">
                        <% if (cat.eligible === 0) { %>
                          <span class="text-muted small">—</span>
                        <% } else if (cat.breachRate > 25) { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= cat.breachRate %>%</span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle"><%= cat.breachRate %>%</span>
                        <% } %>
                      </td>
                      <td class="text-end pe-3">
                        <% if (cat.avgResolutionHours !== null) { %>
                          <%= cat.avgResolutionHours %>h
                        <% } else { %>
                          <span class="text-muted small">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="wf-card h-100">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-clock-history me-2 text-primary"></i>Assignment &amp; Escalation Targets</span>
            </div>
            <div class="wf-card-body">
              <table class="table table-sm align-middle mb-3" style="font-size: 0.75rem;">
                <thead>
                  <tr class="text-muted">
                    <th>Priority</th>
                    <th>Acknowledgement</th>
                    <th>Resolution Target</th>
                    <th>Escalation Interval</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><span class="wf-badge badge-priority-critical"><span class="status-dot"></span>Critical</span></td>
                    <td>Immediate (&lt; 1 hr)</td>
                    <td class="fw-semibold">4 hours</td>
                    <td>Every 1 hour</td>
                  </tr>
                  <tr>
                    <td><span class="wf-badge badge-priority-high"><span class="status-dot"></span>High</span></td>
                    <td>Within 2 hours</td>
                    <td class="fw-semibold">12 hours</td>
                    <td>Every 4 hours</td>
                  </tr>
                  <tr>
                    <td><span class="wf-badge badge-priority-medium"><span class="status-dot"></span>Medium</span></td>
                    <td>Within 4 hours</td>
                    <td>24 hours</td>
                    <td>Every 8 hours</td>
                  </tr>
                  <tr>
                    <td><span class="wf-badge badge-priority-low"><span class="status-dot"></span>Low</span></td>
                    <td>Within 8 hours</td>
                    <td>48 hours</td>
                    <td>Daily</td>
                  </tr>
                </tbody>
              </table>

              <div class="p-2 rounded bg-light border small text-muted" style="font-size: 0.72rem;">
                <i class="bi bi-lightning-charge me-1 text-primary"></i>
                <strong>Automated Daemon:</strong> Background worker checks tickets every 15 minutes, auto-escalating overdue tasks with notifications.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Active Escalation Monitoring Table -->
      <div class="wf-table-container">
        <div class="wf-card-header d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-semibold small text-danger"><i class="bi bi-exclamation-octagon me-2"></i>Active Escalation Monitoring</span>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-2"><%= escalationList.length %> overdue</span>
          </div>
          <span class="text-muted small" style="font-size: 0.72rem;">Sorted by deadline elapsed</span>
        </div>
        <div class="table-responsive">
          <table class="wf-table">
            <thead>
              <tr>
                <th class="ps-4">Ticket</th>
                <th>Title</th>
                <th>Priority</th>
                <th>Department</th>
                <th>Assignee</th>
                <th>Status</th>
                <th>Overdue By</th>
                <th>Escalation Level</th>
                <th class="text-end pe-4">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (!escalationList || escalationList.length === 0) { %>
                <tr>
                  <td colspan="9" class="text-center py-4 text-success small">
                    <i class="bi bi-check2-circle fs-4 d-block mb-1"></i>
                    All active tasks are currently on schedule within their resolution targets!
                  </td>
                </tr>
              <% } else { %>
                <% escalationList.forEach(item => { %>
                  <tr>
                    <td class="ps-4 ticket-code">
                      <a href="/tickets/<%= item._id %>" class="text-decoration-none fw-semibold"><%= item.ticketNumber %></a>
                    </td>
                    <td class="fw-medium text-dark text-truncate" style="max-width: 220px;"><%= item.title %></td>
                    <td>
                      <span class="wf-badge badge-priority-<%= item.priority %> text-uppercase">
                        <span class="status-dot"></span>
                        <%= item.priority %>
                      </span>
                    </td>
                    <td class="small text-secondary"><%= item.departmentName %></td>
                    <td class="small">
                      <% if (item.assigneeName === 'Unassigned') { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Unassigned</span>
                      <% } else { %>
                        <%= item.assigneeName %>
                      <% } %>
                    </td>
                    <td>
                      <span class="wf-badge badge-status-<%= item.status %>">
                        <span class="status-dot"></span>
                        <%= item.status.replace(/_/g, ' ') %>
                      </span>
                    </td>
                    <td class="text-danger fw-semibold small">
                      <i class="bi bi-clock me-1"></i>+<%= item.overdueHours %>
                    </td>
                    <td>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Level <%= item.escalationLevel %></span>
                    </td>
                    <td class="text-end pe-4">
                      <a href="/tickets/<%= item._id %>" class="btn btn-sm btn-outline-danger py-0 px-2 fw-medium" style="font-size: 0.72rem;">
                        View / Action
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>

<script>
  // 1. Data Serialization from Server EJS
  const deptData = <%- JSON.stringify(departmentBottlenecks || []) %>;
  const catData = <%- JSON.stringify(categoryStats || []) %>;

  // 2. Initialize Department Workload Bar Chart
  document.addEventListener('DOMContentLoaded', () => {
    // Filter departments that have at least 1 ticket or top 8
    const filteredDepts = deptData.slice(0, 8);
    const deptLabels = filteredDepts.map(d => d.name.length > 18 ? d.name.substring(0, 16) + '...' : d.name);
    const activeBacklogs = filteredDepts.map(d => d.openBacklog || 0);
    const overdueCounts = filteredDepts.map(d => d.overdueCount || 0);

    const ctxDept = document.getElementById('deptWorkloadChart');
    if (ctxDept) {
      new Chart(ctxDept, {
        type: 'bar',
        data: {
          labels: deptLabels.length ? deptLabels : ['No Data'],
          datasets: [
            {
              label: 'Active Backlog',
              data: activeBacklogs.length ? activeBacklogs : [0],
              backgroundColor: '#0d6efd',
              borderRadius: 4,
              borderSkipped: false,
            },
            {
              label: 'Overdue (Late)',
              data: overdueCounts.length ? overdueCounts : [0],
              backgroundColor: '#dc3545',
              borderRadius: 4,
              borderSkipped: false,
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: { boxWidth: 12, font: { size: 11 } }
            },
            tooltip: {
              callbacks: {
                label: (ctx) => ` ${ctx.dataset.label}: ${ctx.raw} issues`
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { stepSize: 1, font: { size: 11 } },
              grid: { color: '#f1f3f5' }
            },
            x: {
              ticks: { font: { size: 10 } },
              grid: { display: false }
            }
          }
        }
      });
    }

    // 3. Initialize Issues by Category Doughnut Chart
    const ctxCat = document.getElementById('categoryDistChart');
    if (ctxCat) {
      const activeCats = catData.filter(c => c.count > 0);
      const catLabels = activeCats.length ? activeCats.map(c => c.category.charAt(0).toUpperCase() + c.category.slice(1)) : ['No Issues'];
      const catCounts = activeCats.length ? activeCats.map(c => c.count) : [1];
      const palette = ['#0d6efd', '#20c997', '#fd7e14', '#6f42c1', '#ffc107', '#0dcaf0', '#6c757d', '#adb5bd'];

      new Chart(ctxCat, {
        type: 'doughnut',
        data: {
          labels: catLabels,
          datasets: [{
            data: catCounts,
            backgroundColor: palette.slice(0, catLabels.length),
            borderWidth: 2,
            borderColor: '#ffffff',
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'right',
              labels: { boxWidth: 12, font: { size: 11 } }
            },
            tooltip: {
              callbacks: {
                label: (ctx) => ` ${ctx.label}: ${ctx.raw} issues`
              }
            }
          },
          cutout: '62%'
        }
      });
    }
  });

  // 4. AI Explainer Client Logic
  async function explainWithAi() {
    const btn = document.getElementById('btnAiExplain');
    const box = document.getElementById('aiSummaryBox');
    const headlineAlert = document.getElementById('aiHeadlineAlert');
    const headlineIcon = document.getElementById('aiHeadlineIcon');
    const headlineText = document.getElementById('aiHeadlineText');
    const summaryText = document.getElementById('aiSummaryText');
    const pointsContainer = document.getElementById('aiPointsContainer');
    const actionText = document.getElementById('aiActionText');
    const modelBadge = document.getElementById('aiModelBadge');

    const originalBtnHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Analyzing...`;

    // Reveal container with placeholder while fetching
    box.style.display = 'block';
    headlineAlert.className = 'alert alert-info mb-3 fw-semibold py-2 px-3 d-flex align-items-center gap-2';
    headlineIcon.className = 'bi bi-arrow-repeat spin';
    headlineText.textContent = 'Generating plain-language operational summary...';
    summaryText.textContent = 'Analyzing department workloads, overdue response deadlines, and staff availability...';
    pointsContainer.innerHTML = '';

    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    try {
      const response = await fetch('/analytics/explain', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        }
      });

      const data = await response.json();
      if (!data.success) throw new Error(data.error || 'Failed to generate summary');

      // Update badge
      if (data.aiGenerated) {
        modelBadge.textContent = `Generated by Gemini AI · Plain English`;
      } else {
        modelBadge.textContent = `Verified Operational Engine · Plain English`;
      }

      // Update headline banner
      const statusClass = data.statusClass || 'info';
      headlineAlert.className = `alert alert-${statusClass} mb-3 fw-semibold py-2 px-3 d-flex align-items-center gap-2`;
      headlineIcon.className = statusClass === 'danger'
        ? 'bi bi-exclamation-octagon-fill text-danger'
        : (statusClass === 'warning' ? 'bi bi-exclamation-triangle-fill text-warning-emphasis' : 'bi bi-check-circle-fill text-success');
      headlineText.textContent = data.headline;

      // Executive summary paragraph
      summaryText.textContent = data.summary;

      // Render highlight tiles
      if (data.points && data.points.length) {
        pointsContainer.innerHTML = data.points.map(pt => `
          <div class="col-md-6 col-lg-3">
            <div class="ai-pill-card h-100">
              <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi ${pt.icon || 'bi-info-circle'} text-${pt.type}"></i>
                <span class="badge bg-${pt.type}-subtle text-${pt.type} border border-${pt.type}-subtle small">
                  ${pt.badge}
                </span>
              </div>
              <div class="small text-dark fw-medium lh-sm">${pt.text}</div>
            </div>
          </div>
        `).join('');
      }

      // Recommended action
      actionText.textContent = data.nextStep;

    } catch (err) {
      console.error('AI summary error:', err);
      headlineAlert.className = 'alert alert-danger mb-3 py-2 px-3 d-flex align-items-center gap-2';
      headlineIcon.className = 'bi bi-exclamation-triangle-fill text-danger';
      headlineText.textContent = 'Could not generate summary at this moment.';
      summaryText.textContent = 'Please review the KPI tiles and department breakdown tables below.';
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalBtnHtml;
    }
  }

  function closeAiSummary() {
    const box = document.getElementById('aiSummaryBox');
    if (box) box.style.display = 'none';
  }
</script>
</body>
</html>