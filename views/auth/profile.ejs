<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="mb-4">
        <h5 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>User Profile &amp; Security Settings</h5>
        <p class="text-muted small mb-0">Manage your staff contact info and password.</p>
      </div>

      <div class="row g-4">
        <div class="col-md-6">
          <div class="wf-card h-100">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-person me-2 text-primary"></i>Profile Details</span>
            </div>
            <div class="wf-card-body">
              <form method="POST" action="/auth/profile">
                <div class="mb-3">
                  <label class="form-label">Full Name</label>
                  <input type="text" class="form-control form-control-sm" name="name" value="<%= user.name %>" required />
                </div>
                <div class="mb-3">
                  <label class="form-label">Hospital Email Address</label>
                  <input type="email" class="form-control form-control-sm bg-light" value="<%= user.email %>" disabled />
                  <div class="form-text" style="font-size: 0.7rem;">Email managed by hospital administrator.</div>
                </div>
                <div class="mb-3">
                  <label class="form-label">Contact Phone</label>
                  <input type="tel" class="form-control form-control-sm" name="phone" value="<%= user.phone || '' %>" placeholder="+91 98765 43210" />
                </div>
                <div class="mb-4">
                  <label class="form-label">Assigned Role</label>
                  <input type="text" class="form-control form-control-sm bg-light text-capitalize" value="<%= user.role.replace(/_/g,' ') %>" disabled />
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Save Profile Changes</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="wf-card h-100">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-shield-lock me-2 text-warning"></i>Security &amp; Password</span>
            </div>
            <div class="wf-card-body">
              <form method="POST" action="/auth/profile">
                <input type="hidden" name="name" value="<%= user.name %>" />
                <div class="mb-3">
                  <label class="form-label">Current Password</label>
                  <input type="password" class="form-control form-control-sm" name="currentPassword" placeholder="Enter existing password" />
                </div>
                <div class="mb-4">
                  <label class="form-label">New Password</label>
                  <input type="password" class="form-control form-control-sm" name="newPassword" minlength="8" placeholder="Minimum 8 characters" />
                </div>
                <button type="submit" class="btn btn-sm btn-outline-primary">Update Password</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
