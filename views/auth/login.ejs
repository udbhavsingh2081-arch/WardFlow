<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — WardFlow Operations</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    body {
      background-color: #0b1320;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .login-container {
      max-width: 440px;
      width: 100%;
      padding: 1.5rem;
    }
    .login-card {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.1);
      overflow: hidden;
    }
    .brand-mark {
      width: 44px;
      height: 44px;
      background: #0f52ba;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 1.4rem;
      box-shadow: 0 4px 6px -1px rgba(15, 82, 186, 0.3);
    }
    .btn-demo-role {
      font-size: 0.72rem;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      color: #334155;
      text-align: left;
      cursor: pointer;
      transition: all 0.1s ease;
    }
    .btn-demo-role:hover {
      background: #eff6ff;
      border-color: #bfdbfe;
      color: #1d4ed8;
    }
  </style>
</head>
<body>
<div class="login-container">
  <div class="text-center mb-3">
    <div class="brand-mark mb-2">
      <i class="bi bi-hospital"></i>
    </div>
    <h4 class="fw-bold text-white mb-0">WardFlow</h4>
    <p class="small text-secondary" style="color: #94a3b8 !important;">Hospital Operations &amp; Issue Resolution Platform</p>
  </div>

  <div class="card login-card">
    <div class="card-body p-4">
      <% if (locals.flash && flash.error) { %>
      <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= flash.error %></span>
      </div>
      <% } %>
      <% if (locals.flash && flash.success) { %>
      <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-check-circle-fill"></i>
        <span><%= flash.success %></span>
      </div>
      <% } %>

      <form method="POST" action="/auth/login" autocomplete="on">
        <div class="mb-3">
          <label class="form-label small fw-semibold text-secondary">Hospital Email Address</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control border-start-0 ps-0" name="email" id="loginEmail" required autofocus placeholder="name@citycare.in" />
          </div>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <label class="form-label small fw-semibold text-secondary mb-1">Password</label>
          </div>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control border-start-0 ps-0" name="password" id="loginPassword" required placeholder="••••••••" />
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-1" style="background-color: #0f52ba; border-color: #0f52ba;">
          Sign In to WardFlow
        </button>
      </form>

      <!-- Demo Accounts Picker -->
      <div class="mt-4 pt-3 border-top">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="meta-label text-muted" style="font-size: 0.65rem;">Quick Role Switcher (Evaluation)</span>
        </div>
        <div class="d-grid gap-1">
          <button type="button" class="btn-demo-role" onclick="setLogin('admin@citycare.in', 'Admin@1234')">
            <strong>Hospital Admin:</strong> admin@citycare.in
          </button>
          <button type="button" class="btn-demo-role" onclick="setLogin('ops@citycare.in', 'Ops@1234')">
            <strong>Operations Manager:</strong> ops@citycare.in
          </button>
          <button type="button" class="btn-demo-role" onclick="setLogin('supervisor@citycare.in', 'Super@1234')">
            <strong>Dept Supervisor:</strong> supervisor@citycare.in
          </button>
          <button type="button" class="btn-demo-role" onclick="setLogin('maintenance@citycare.in', 'Staff@1234')">
            <strong>Support Staff:</strong> maintenance@citycare.in
          </button>
          <button type="button" class="btn-demo-role" onclick="setLogin('reporter@citycare.in', 'Report@1234')">
            <strong>Issue Reporter:</strong> reporter@citycare.in
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center mt-3 text-muted" style="font-size: 0.7rem; color: #64748b !important;">
    <i class="bi bi-shield-check me-1 text-success"></i>WardFlow Enterprise &bull; Tenant Isolation &bull; Audit Trail Active
  </div>
</div>

<script>
  function setLogin(email, pw) {
    document.getElementById('loginEmail').value = email;
    document.getElementById('loginPassword').value = pw;
  }
</script>
</body>
</html>
