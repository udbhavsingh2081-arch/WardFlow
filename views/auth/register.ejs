<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Reporter Account — WardFlow Operations</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    body {
      background-color: #0b1320;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
      padding: 1.5rem 0;
    }
    .register-container {
      max-width: 480px;
      width: 100%;
      padding: 1rem;
    }
    .register-card {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.1);
      overflow: hidden;
    }
    .brand-mark {
      width: 44px;
      height: 44px;
      background: #0f52ba;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 1.4rem;
      box-shadow: 0 4px 6px -1px rgba(15, 82, 186, 0.3);
    }
  </style>
</head>
<body>
<div class="register-container">
  <div class="text-center mb-3">
    <div class="brand-mark mb-2">
      <i class="bi bi-hospital"></i>
    </div>
    <h4 class="fw-bold text-white mb-0">WardFlow</h4>
    <p class="small text-secondary" style="color: #94a3b8 !important;">Create Account &bull; Issue Reporting &amp; Request Tracking</p>
  </div>

  <div class="card register-card">
    <div class="card-body p-4">
      <% if (locals.flash && flash.error) { %>
      <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= flash.error %></span>
      </div>
      <% } %>

      <h6 class="fw-bold text-dark mb-1">Reporter Registration</h6>
      <p class="small text-muted mb-3">Sign up to submit hospital repair requests and track real-time technician progress.</p>

      <form method="POST" action="/auth/register" autocomplete="on">
        <div class="mb-3">
          <label class="form-label small fw-semibold text-secondary">Full Name <span class="text-danger">*</span></label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" name="name" required placeholder="e.g. Dr. Priya Patel / Nurse John" />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold text-secondary">Email Address <span class="text-danger">*</span></label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control border-start-0 ps-0" name="email" required placeholder="your.name@hospital.com" />
          </div>
        </div>

        <div class="row g-2 mb-3">
          <div class="col-sm-6">
            <label class="form-label small fw-semibold text-secondary">Department / Ward</label>
            <select class="form-select form-select-sm" name="departmentId">
              <option value="">General Facility</option>
              <% if (departments && departments.length > 0) { %>
                <% departments.forEach(d => { %>
                  <option value="<%= d._id %>"><%= d.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="col-sm-6">
            <label class="form-label small fw-semibold text-secondary">Phone Number</label>
            <input type="tel" class="form-control form-control-sm" name="phone" placeholder="+91 98765 43210" />
          </div>
        </div>

        <div class="row g-2 mb-3">
          <div class="col-sm-6">
            <label class="form-label small fw-semibold text-secondary">Password <span class="text-danger">*</span></label>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
              <input type="password" class="form-control border-start-0 ps-0" name="password" required minlength="8" placeholder="Min 8 characters" />
            </div>
          </div>
          <div class="col-sm-6">
            <label class="form-label small fw-semibold text-secondary">Confirm Password <span class="text-danger">*</span></label>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-check"></i></span>
              <input type="password" class="form-control border-start-0 ps-0" name="confirmPassword" required minlength="8" placeholder="Repeat password" />
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-1" style="background-color: #0f52ba; border-color: #0f52ba;">
          <i class="bi bi-person-plus me-1"></i>Create Reporter Account
        </button>
      </form>

      <div class="text-center mt-3 pt-3 border-top">
        <span class="small text-muted">Already have an account?</span>
        <a href="/auth/login" class="small fw-semibold text-primary text-decoration-none ms-1">
          Sign In here <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="text-center mt-3 text-muted" style="font-size: 0.7rem; color: #64748b !important;">
    <i class="bi bi-shield-check me-1 text-success"></i>WardFlow Enterprise &bull; Role-Based Access Control &bull; SLA Tracked
  </div>
</div>
</body>
</html>
