<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>
    <div class="card border-0 shadow-sm" style="max-width:580px">
      <div class="card-header fw-semibold bg-white"><i class="bi bi-gear me-2 text-primary"></i>Hospital Tenant Configuration</div>
      <div class="card-body">
        <form method="POST" action="/admin/settings">
          <div class="mb-3">
            <label class="form-label fw-semibold">Hospital Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" value="<%= hospital.name %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Facility Address</label>
            <textarea class="form-control" name="address" rows="2"><%= hospital.address || '' %></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Contact Phone</label>
            <input type="tel" class="form-control" name="phone" value="<%= hospital.phone || '' %>" />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Operational Timezone</label>
            <input type="text" class="form-control" name="timezone" value="<%= hospital.timezone || 'Asia/Kolkata' %>" />
            <div class="form-text">e.g. Asia/Kolkata (IST)</div>
          </div>
          <div class="mb-4 form-check">
            <input type="checkbox" class="form-check-input" name="requireVerification" id="reqVerif" <%= hospital.settings && hospital.settings.requireVerification ? 'checked' : '' %> />
            <label class="form-check-label fw-semibold" for="reqVerif">Enforce independent supervisor verification before ticket closure</label>
            <div class="form-text">When enabled, resolved tickets require sign-off by a supervisor or manager to close.</div>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">Save Configuration</button>
        </form>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
