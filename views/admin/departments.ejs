<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Departments — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6 class="fw-semibold mb-0">Hospital Departments</h6>
      <a href="/admin/departments/new" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Department</a>
    </div>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Name</th>
              <th>Code</th>
              <th>Supervisor</th>
              <th>Default Assigned Team</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (departments.length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted py-4">No departments configured.</td></tr>
            <% } %>
            <% departments.forEach(d => { %>
            <tr>
              <td class="ps-3 fw-semibold"><%= d.name %></td>
              <td><span class="badge bg-secondary"><%= d.code || '—' %></span></td>
              <td><%= d.supervisorId ? d.supervisorId.name : '<span class="text-muted">None</span>' %></td>
              <td class="text-muted small"><%= d.defaultAssignedTeam || '—' %></td>
              <td><span class="badge <%= d.isActive ? 'bg-success' : 'bg-secondary' %>"><%= d.isActive ? 'Active' : 'Inactive' %></span></td>
              <td><a href="/admin/departments/<%= d._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
