<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Departments — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h5 class="fw-bold mb-1"><i class="bi bi-building text-primary me-2"></i>Hospital Departments</h5>
          <p class="text-muted small mb-0">Configure operational clinical wards, technical teams, and supervisor routing.</p>
        </div>
        <a href="/admin/departments/new" class="btn btn-primary btn-sm">
          <i class="bi bi-plus-lg me-1"></i>Add Department
        </a>
      </div>

      <div class="wf-table-container">
        <div class="table-responsive">
          <table class="wf-table">
            <thead>
              <tr>
                <th class="ps-4">Department Name</th>
                <th>Code</th>
                <th>Assigned Supervisor</th>
                <th>Default Maintenance Team</th>
                <th>Status</th>
                <th class="text-end pe-4">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (departments.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted py-4">No departments configured yet.</td></tr>
              <% } %>
              <% departments.forEach(d => { %>
              <tr>
                <td class="ps-4 fw-semibold text-dark"><%= d.name %></td>
                <td><span class="badge bg-light text-secondary border font-monospace"><%= d.code || '—' %></span></td>
                <td class="small">
                  <% if (d.supervisorId) { %>
                    <%= d.supervisorId.name %>
                  <% } else { %>
                    <span class="text-muted">Unassigned</span>
                  <% } %>
                </td>
                <td class="small text-secondary"><%= d.defaultAssignedTeam || '—' %></td>
                <td>
                  <span class="badge <%= d.isActive ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-light text-secondary border' %>">
                    <%= d.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <a href="/admin/departments/<%= d._id %>/edit" class="btn btn-sm btn-outline-secondary py-0 px-2">Edit</a>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
