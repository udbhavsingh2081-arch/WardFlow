<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SLA Policies — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="mb-4">
        <h5 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Service Level Agreement (SLA) &amp; Escalation Thresholds</h5>
        <p class="text-muted small mb-0">Configure operational turnaround targets per priority. The background escalation worker applies these thresholds automatically.</p>
      </div>

      <div class="row g-3">
        <% ['critical','high','medium','low'].forEach(priority => {
          const policy = policies.find(p => p.priority === priority) || {};
          const defaults = { critical: [0.5, 1, 4], high: [1, 2, 12], medium: [4, 8, 24], low: [8, 24, 48] };
          const [defAck, defResp, defRes] = defaults[priority];
        %>
        <div class="col-md-6">
          <div class="wf-card h-100">
            <div class="wf-card-header">
              <span class="wf-badge badge-priority-<%= priority %> text-uppercase">
                <span class="status-dot"></span>
                <%= priority %> Priority
              </span>
              <span class="meta-label">Response Rules</span>
            </div>
            <div class="wf-card-body">
              <form method="POST" action="/admin/sla">
                <input type="hidden" name="priority" value="<%= priority %>" />
                <div class="row g-2 mb-3">
                  <div class="col-4">
                    <label class="form-label">Ack (hrs)</label>
                    <input type="number" class="form-control form-control-sm" name="acknowledgementHours" value="<%= policy.acknowledgementHours || defAck %>" min="0.1" step="0.5" required />
                    <div class="text-muted" style="font-size: 0.6875rem;">Until assignment</div>
                  </div>
                  <div class="col-4">
                    <label class="form-label">Response (hrs)</label>
                    <input type="number" class="form-control form-control-sm" name="responseHours" value="<%= policy.responseHours || defResp %>" min="0.1" step="0.5" required />
                    <div class="text-muted" style="font-size: 0.6875rem;">Until work starts</div>
                  </div>
                  <div class="col-4">
                    <label class="form-label">Resolution (hrs)</label>
                    <input type="number" class="form-control form-control-sm" name="resolutionHours" value="<%= policy.resolutionHours || defRes %>" min="0.1" step="0.5" required />
                    <div class="text-muted" style="font-size: 0.6875rem;">Target deadline</div>
                  </div>
                </div>
                <div class="form-check mb-3">
                  <input type="checkbox" class="form-check-input" name="useBusinessHours" id="bh_<%= priority %>" <%= policy.useBusinessHours !== false ? 'checked' : '' %> />
                  <label class="form-check-label small" for="bh_<%= priority %>">Calculate using hospital business hours only</label>
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Save Policy</button>
              </form>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
