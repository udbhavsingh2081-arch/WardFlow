<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="row justify-content-center">
        <div class="col-lg-7">
          <div class="d-flex align-items-center mb-3">
            <a href="/admin/departments" class="btn btn-outline-secondary btn-sm me-3">
              <i class="bi bi-arrow-left me-1"></i>Back
            </a>
            <h5 class="mb-0 fw-bold"><%= department._id ? 'Edit Department' : 'Create New Department' %></h5>
          </div>

          <div class="wf-card">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-building me-1 text-primary"></i>Department Configuration</span>
            </div>
            <div class="wf-card-body">
              <form method="POST" action="<%= department._id ? '/admin/departments/' + department._id : '/admin/departments' %>">
                <div class="mb-3">
                  <label class="form-label">Department Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control form-control-sm" name="name" value="<%= department.name || '' %>" required placeholder="e.g. Intensive Care Unit, Maintenance, Radiology" />
                </div>
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Department Code</label>
                    <input type="text" class="form-control form-control-sm font-monospace" name="code" value="<%= department.code || '' %>" placeholder="e.g. ICU, MAINT, RAD" />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Default Maintenance Team</label>
                    <input type="text" class="form-control form-control-sm" name="defaultAssignedTeam" value="<%= department.defaultAssignedTeam || '' %>" placeholder="e.g. Bio-Med, Electrical" />
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label">Assigned Supervisor</label>
                  <select class="form-select form-select-sm" name="supervisorId">
                    <option value="">— Unassigned —</option>
                    <% supervisors.forEach(s => { %>
                    <option value="<%= s._id %>" <%= department.supervisorId && department.supervisorId.toString() === s._id.toString() ? 'selected' : '' %>><%= s.name %></option>
                    <% }) %>
                  </select>
                </div>
                <% if (department._id) { %>
                <div class="form-check mb-4">
                  <input type="checkbox" class="form-check-input" name="isActive" id="isActive" <%= department.isActive !== false ? 'checked' : '' %> />
                  <label class="form-check-label small" for="isActive">Active Department</label>
                </div>
                <% } %>
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-sm btn-primary">Save Department</button>
                  <a href="/admin/departments" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
