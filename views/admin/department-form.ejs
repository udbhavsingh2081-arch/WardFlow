<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>
    <div class="card border-0 shadow-sm" style="max-width:540px">
      <div class="card-header fw-semibold bg-white"><%= title %></div>
      <div class="card-body">
        <form method="POST" action="<%= department._id ? '/admin/departments/' + department._id : '/admin/departments' %>">
          <div class="mb-3">
            <label class="form-label fw-semibold">Department Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" value="<%= department.name || '' %>" required placeholder="e.g. Intensive Care Unit" />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Code</label>
            <input type="text" class="form-control" name="code" value="<%= department.code || '' %>" placeholder="e.g. ICU, MAINT" />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Designated Supervisor</label>
            <select class="form-select" name="supervisorId">
              <option value="">None (Unassigned)</option>
              <% supervisors.forEach(u => { %>
              <option value="<%= u._id %>" <%= department.supervisorId && department.supervisorId.toString() === u._id.toString() ? 'selected' : '' %>><%= u.name %> (<%= u.role.replace('_',' ') %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Default Assigned Support Team</label>
            <input type="text" class="form-control" name="defaultAssignedTeam" value="<%= department.defaultAssignedTeam || '' %>" placeholder="e.g. Facilities Maintenance" />
          </div>
          <% if (department._id) { %>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" name="isActive" id="isActive" <%= department.isActive ? 'checked' : '' %> />
            <label class="form-check-label" for="isActive">Active department</label>
          </div>
          <% } %>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Save Department</button>
            <a href="/admin/departments" class="btn btn-outline-secondary btn-sm">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
