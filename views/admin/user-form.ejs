<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <%- include('../partials/flash') %>
    <div class="card border-0 shadow-sm" style="max-width:580px">
      <div class="card-header fw-semibold bg-white"><%= title %></div>
      <div class="card-body">
        <form method="POST" action="<%= editUser._id ? '/admin/users/' + editUser._id : '/admin/users' %>">
          <div class="mb-3">
            <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" value="<%= editUser.name || '' %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" name="email" value="<%= editUser.email || '' %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Phone Number</label>
            <input type="tel" class="form-control" name="phone" value="<%= editUser.phone || '' %>" placeholder="+91 98765 43210" />
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">System Role <span class="text-danger">*</span></label>
            <select class="form-select text-capitalize" name="role" required>
              <% ['reporter','staff','supervisor','operations_manager','hospital_admin'].forEach(r => { %>
              <option value="<%= r %>" <%= editUser.role === r ? 'selected' : '' %>><%= r.replace(/_/g,' ') %></option>
              <% }) %>
            </select>
            <div class="form-text">Controls permissions across tickets, assignment, and configuration.</div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Assigned Departments</label>
            <div class="p-2 border rounded bg-light" style="max-height: 150px; overflow-y: auto;">
              <% departments.forEach(d => { %>
              <div class="form-check">
                <input type="checkbox" class="form-check-input" name="departmentIds" value="<%= d._id %>" id="dept_<%= d._id %>" <%= editUser.departmentIds && editUser.departmentIds.map(id => id.toString()).includes(d._id.toString()) ? 'checked' : '' %> />
                <label class="form-check-label small" for="dept_<%= d._id %>"><%= d.name %></label>
              </div>
              <% }) %>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Password <%= editUser._id ? '(leave blank to keep unchanged)' : '*' %></label>
            <input type="password" class="form-control" name="password" minlength="8" <%= editUser._id ? '' : 'required' %> placeholder="Minimum 8 characters" />
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Save User</button>
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
