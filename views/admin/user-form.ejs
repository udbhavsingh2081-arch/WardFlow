<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="row justify-content-center">
        <div class="col-lg-7">
          <div class="d-flex align-items-center mb-3">
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm me-3">
              <i class="bi bi-arrow-left me-1"></i>Back
            </a>
            <h5 class="mb-0 fw-bold"><%= editUser._id ? 'Edit User Account' : 'Add New User Account' %></h5>
          </div>

          <div class="wf-card">
            <div class="wf-card-header">
              <span class="fw-semibold small"><i class="bi bi-person me-1 text-primary"></i>User Credentials &amp; Access</span>
            </div>
            <div class="wf-card-body">
              <form method="POST" action="<%= editUser._id ? '/admin/users/' + editUser._id : '/admin/users' %>">
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" name="name" value="<%= editUser.name || '' %>" required />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input type="email" class="form-control form-control-sm" name="email" value="<%= editUser.email || '' %>" required />
                  </div>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Phone</label>
                    <input type="tel" class="form-control form-control-sm" name="phone" value="<%= editUser.phone || '' %>" placeholder="+91 98765 43210" />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">System Role <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm text-capitalize" name="role" required>
                      <% const roles = ['reporter','staff','supervisor','operations_manager','hospital_admin']; %>
                      <% roles.forEach(r => { %>
                      <option value="<%= r %>" <%= editUser.role === r ? 'selected' : '' %>><%= r.replace(/_/g,' ') %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label">Associated Departments</label>
                  <select class="form-select form-select-sm" name="departmentIds" multiple size="4">
                    <% departments.forEach(d => { %>
                    <option value="<%= d._id %>" <%= (editUser.departmentIds || []).map(id => id.toString()).includes(d._id.toString()) ? 'selected' : '' %>><%= d.name %></option>
                    <% }) %>
                  </select>
                  <div class="form-text" style="font-size: 0.7rem;">Hold Ctrl/Cmd to select multiple departments.</div>
                </div>

                <div class="mb-4">
                  <label class="form-label">Password <%= editUser._id ? '(Leave blank to keep unchanged)' : '*' %></label>
                  <input type="password" class="form-control form-control-sm" name="password" minlength="8" <%= editUser._id ? '' : 'required' %> placeholder="Minimum 8 characters" />
                </div>

                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-sm btn-primary">Save User</button>
                  <a href="/admin/users" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
