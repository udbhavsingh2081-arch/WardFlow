<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/wardflow.css" />
</head>
<body>
<div class="d-flex">
  <%- include('../partials/sidebar') %>
  <main class="wf-main flex-grow-1">
    <%- include('../partials/topbar') %>
    <div class="wf-content">
      <%- include('../partials/flash') %>

      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h5 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Staff &amp; User Accounts</h5>
          <p class="text-muted small mb-0">Manage hospital staff roles, departmental access, and login permissions.</p>
        </div>
        <a href="/admin/users/new" class="btn btn-primary btn-sm">
          <i class="bi bi-person-plus me-1"></i>Add User
        </a>
      </div>

      <div class="wf-table-container">
        <div class="table-responsive">
          <table class="wf-table">
            <thead>
              <tr>
                <th class="ps-4">Staff Member</th>
                <th>Email Address</th>
                <th>Assigned Role</th>
                <th>Status</th>
                <th>Last Active</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
              <tr>
                <td class="ps-4">
                  <div class="fw-semibold text-dark"><%= u.name %></div>
                  <div class="text-muted" style="font-size: 0.7rem;"><%= u.phone || 'No phone recorded' %></div>
                </td>
                <td class="small text-secondary font-monospace"><%= u.email %></td>
                <td>
                  <span class="badge bg-light text-secondary border text-capitalize fw-normal">
                    <%= u.role.replace(/_/g, ' ') %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= u.isActive ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-light text-secondary border' %>">
                    <%= u.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="small text-muted">
                  <%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleDateString('en-IN') : 'Never' %>
                </td>
                <td class="text-end pe-4">
                  <div class="btn-group btn-group-sm">
                    <a href="/admin/users/<%= u._id %>/edit" class="btn btn-outline-secondary">Edit</a>
                    <form method="POST" action="/admin/users/<%= u._id %>/toggle" class="d-inline">
                      <button type="submit" class="btn btn-outline-<%= u.isActive ? 'danger' : 'success' %>" data-confirm="Are you sure you want to <%= u.isActive ? 'deactivate' : 'activate' %> <%= u.name %>?">
                        <%= u.isActive ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/wardflow.js"></script>
</body>
</html>
