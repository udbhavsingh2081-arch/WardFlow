<% if (flash && flash.success) { %>
<div class="wf-alert wf-alert-success alert-dismissible alert-auto-dismiss d-flex align-items-center justify-content-between" role="alert">
  <div class="d-flex align-items-center gap-2">
    <i class="bi bi-check-circle-fill text-success"></i>
    <span><%= flash.success %></span>
  </div>
  <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.65rem;"></button>
</div>
<% } %>
<% if (flash && flash.error) { %>
<div class="wf-alert wf-alert-danger alert-dismissible alert-auto-dismiss d-flex align-items-center justify-content-between" role="alert">
  <div class="d-flex align-items-center gap-2">
    <i class="bi bi-exclamation-triangle-fill text-danger"></i>
    <span><%= flash.error %></span>
  </div>
  <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.65rem;"></button>
</div>
<% } %>
<% if (flash && flash.info) { %>
<div class="wf-alert wf-alert-info alert-dismissible alert-auto-dismiss d-flex align-items-center justify-content-between" role="alert">
  <div class="d-flex align-items-center gap-2">
    <i class="bi bi-info-circle-fill text-primary"></i>
    <span><%= flash.info %></span>
  </div>
  <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.65rem;"></button>
</div>
<% } %>
